# ============================================================
# SiBangku Environment Configuration
# ============================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git.
# ============================================================

# Node
NODE_ENV=development
PORT_CONTROL_API=3001
PORT_TENANT_API=3002
PORT_WEB=3000

# Control Plane Database
CONTROL_DATABASE_URL=postgresql://sibangku:sibangku_dev@localhost:5432/sibangku_control

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=24h

# Password Hashing
BCRYPT_ROUNDS=12

# Platform
PLATFORM_NAME=SiBangku
DEFAULT_TRIAL_DAYS=60
DEFAULT_TIMEZONE=Asia/Jakarta
DEFAULT_CURRENCY=IDR
DEFAULT_LANGUAGE=id

# Image Storage (S3-compatible / MinIO for dev)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=sibangku
STORAGE_REGION=us-east-1

# Payment (Adapter - configure per tenant)
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# XENDIT_SECRET_KEY=

# Grace Period
GRACE_PERIOD_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
