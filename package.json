{
  "name": "sibangku",
  "version": "2.0.0",
  "private": true,
  "description": "SiBangku - White-Label Restaurant Reservation SaaS Platform",
  "scripts": {
    "dev:control-api": "pnpm --filter @sibangku/control-api dev",
    "dev:tenant-api": "pnpm --filter @sibangku/tenant-api dev",
    "dev:web": "pnpm --filter @sibangku/web dev",
    "dev:worker": "pnpm --filter @sibangku/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sibangku/db generate",
    "db:migrate": "pnpm --filter @sibangku/db migrate",
    "db:studio": "pnpm --filter @sibangku/db studio",
    "clean": "pnpm -r exec rm -rf dist node_modules .next",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
