@inherits LayoutComponentBase

<div class="d-flex flex-column min-vh-100">
    <!-- Floating Capsule Navigation Bar with Frosted Glassmorphism -->
    <header class="ms-capsule-navbar-wrapper">
        <div class="ms-capsule-navbar">
            <a href="/" class="ms-capsule-brand">
                <img src="brand/Navbar-Header-Logo.svg" alt="SiBangku SaaS" class="ms-capsule-brand-img" />
            </a>

            <div class="d-flex align-items-center gap-2">
                <a href="/" class="ms-capsule-nav-link">
                    <i class="bi bi-house"></i> Beranda
                </a>
                <a href="/booking" class="ms-btn ms-btn-primary ms-btn-sm text-nowrap gold-shimmer-btn px-3 py-1.5" style="border-radius: 9999px;">
                    <i class="bi bi-calendar-check"></i> Pesan Meja
                </a>
            </div>
        </div>
    </header>

    <main class="flex-grow-1">
        @Body
    </main>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss"><i class="bi bi-x"></i></span>
    </div>
</div>

