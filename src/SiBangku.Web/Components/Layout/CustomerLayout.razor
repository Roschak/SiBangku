@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService Lang
@inject IJSRuntime JS

<!-- Top Glowing Champagne Scroll Progress Indicator -->
<div id="sibangku-scroll-progress"></div>

<!-- Floating Luxury Back-to-Top Button with Circular Progress Ring -->
<button id="sibangku-back-to-top" type="button" aria-label="@Lang.Get("Quick_Home", "Kembali ke atas")" onclick="window.SiBangkuScroll ? window.SiBangkuScroll.scrollToTop() : window.scrollTo({top:0,behavior:'smooth'})">
    <svg class="progress-ring" viewBox="0 0 48 48">
        <circle class="progress-ring-circle" cx="24" cy="24" r="22"></circle>
    </svg>
    <i class="bi bi-arrow-up"></i>
</button>

<!-- Floating Section Quick-Jump Rail for Desktop -->
<aside id="sibangku-quick-jump-rail" class="ms-quick-jump-rail d-none d-xl-flex" aria-label="Navigasi Bagian Cepat">
    <div class="ms-quick-jump-track"></div>
    <div class="ms-quick-jump-thumb" id="quick-jump-thumb"></div>
    <a href="#hero" class="ms-quick-jump-dot active" data-target="#hero" title="@Lang.Get("Quick_Home", "Beranda")">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#simulasi" class="ms-quick-jump-dot" data-target="#simulasi" title="@Lang.Get("Nav_Floorplan", "Denah Meja")">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#keunggulan" class="ms-quick-jump-dot" data-target="#keunggulan" title="@Lang.Get("Nav_Features", "Keunggulan")">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#alur" class="ms-quick-jump-dot" data-target="#alur" title="@Lang.Get("Nav_HowItWorks", "Cara Kerja")">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#teknologi" class="ms-quick-jump-dot" data-target="#teknologi" title="@Lang.Get("Nav_Tech", "Arsitektur")">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#cta" class="ms-quick-jump-dot" data-target="#cta" title="@Lang.Get("Quick_CTA", "Mulai Reservasi")">
        <span class="ms-quick-jump-inner"></span>
    </a>
</aside>

<div class="ms-customer-portal d-flex flex-column min-vh-100">
    <!-- Editorial Luxury Navigation Bar (Floating Capsule with Frosted Glassmorphism) -->
    <header class="ms-public-navbar sticky-top">
        <div class="ms-navbar-capsule">
            <div class="d-flex align-items-center gap-3 gap-lg-4">
                <!-- Official SiBangku Brand Logo (Gold on Espresso Mark with Dark Typography) -->
                <a href="/" class="text-decoration-none d-inline-flex align-items-center">
                    <img src="brand/Navbar-Header-Logo.svg" alt="SiBangku Hospitality" style="height: 38px; width: auto;" />
                </a>

                <nav class="d-none d-lg-flex align-items-center gap-1 ms-1">
                    <NavLink class="ms-public-nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house"></i> @Lang["Nav_Home"]
                    </NavLink>
                    <a class="ms-public-nav-link" href="#simulasi">
                        <i class="bi bi-grid-1x2"></i> @Lang.Get("Nav_Floorplan", "Denah Meja")
                    </a>
                    <a class="ms-public-nav-link" href="#keunggulan">
                        <i class="bi bi-gem"></i> @Lang.Get("Nav_Features", "Keunggulan")
                    </a>
                    <a class="ms-public-nav-link" href="#alur">
                        <i class="bi bi-signpost-split"></i> @Lang.Get("Nav_HowItWorks", "3 Langkah")
                    </a>
                    <a class="ms-public-nav-link" href="#teknologi">
                        <i class="bi bi-cpu"></i> @Lang.Get("Nav_Tech", "Arsitektur")
                    </a>
                    <NavLink class="ms-public-nav-link" href="booking">
                        <i class="bi bi-calendar2-check"></i> @Lang["Nav_Booking"]
                    </NavLink>
                </nav>
            </div>

            <div class="d-flex align-items-center gap-2">
                <!-- Language Selector Button (capsule style) -->
                <button type="button"
                        class="btn btn-sm font-mono d-inline-flex align-items-center gap-1.5 px-3 py-1.5"
                        style="background: rgba(255,255,255,0.9); border: 1.5px solid rgba(184, 142, 45, 0.40); border-radius: 9999px; font-size: 0.78rem; font-weight: 700; color: var(--ms-text-main); box-shadow: 0 2px 8px rgba(45,35,20,0.06); transition: all 0.2s;"
                        @onclick="() => IsLanguageSelectorOpen = true"
                        title="@Lang["Nav_Language"]">
                    <span style="font-size: 1rem; line-height: 1;">@GetFlagEmoji(Lang.CurrentLanguage)</span>
                    <span class="text-uppercase fw-bold" style="color: var(--ms-text-main);">@Lang.CurrentLanguage</span>
                    <i class="bi bi-chevron-down" style="font-size: 0.65rem; color: #B88E2D;"></i>
                </button>

                <a href="/booking" class="ms-btn ms-btn-primary ms-btn-sm text-nowrap d-none d-sm-inline-flex gold-shimmer-btn rounded-pill px-3.5">
                    <i class="bi bi-calendar-plus me-1"></i>
                    <span>@Lang["Nav_BookNow"]</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Premium Footer -->
    <footer class="ms-footer-premium py-5 mt-auto">
        <div class="container py-3">
            <div class="row g-5 align-items-start justify-content-between">

                <!-- Brand column -->
                <div class="col-lg-4 col-md-5 text-center text-md-start">
                    <a href="/" class="d-inline-flex align-items-center mb-3">
                        <img src="brand/Navbar-Header-Logo.svg" alt="SiBangku" style="height: 38px; width: auto;" />
                    </a>
                    <p class="small mb-4" style="color: var(--ms-text-muted); line-height: 1.75; max-width: 320px;">
                        @Lang["Footer_Description"]
                    </p>
                    <div class="d-flex gap-2 justify-content-center justify-content-md-start flex-wrap">
                        <a href="/booking" class="ms-btn ms-btn-primary ms-btn-sm gold-shimmer-btn">
                            <i class="bi bi-calendar-plus"></i>
                            <span>@Lang["Nav_BookNow"]</span>
                        </a>
                        <a href="/admin" class="ms-btn ms-btn-secondary ms-btn-sm">
                            <i class="bi bi-shop" style="color:#B88E2D;"></i>
                            <span>@Lang["Nav_RestoAdmin"]</span>
                        </a>
                    </div>
                </div>

                <!-- Nav columns -->
                <div class="col-lg-4 col-md-7">
                    <div class="row g-4">
                        <div class="col-6">
                            <h6 class="font-mono fw-bold mb-3" style="font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; color:#B88E2D;">Platform</h6>
                            <div class="d-flex flex-column gap-2">
                                <a href="/" class="ms-footer-link"><i class="bi bi-house me-2 opacity-50"></i>@Lang["Nav_Home"]</a>
                                <a href="#simulasi" class="ms-footer-link"><i class="bi bi-grid-1x2 me-2 opacity-50"></i>@Lang.Get("Nav_Floorplan","Denah Meja")</a>
                                <a href="#keunggulan" class="ms-footer-link"><i class="bi bi-gem me-2 opacity-50"></i>@Lang.Get("Nav_Features","Keunggulan")</a>
                                <a href="#alur" class="ms-footer-link"><i class="bi bi-signpost-split me-2 opacity-50"></i>@Lang.Get("Nav_HowItWorks","Cara Kerja")</a>
                                <a href="/booking" class="ms-footer-link"><i class="bi bi-calendar2-check me-2 opacity-50"></i>@Lang["Nav_Booking"]</a>
                            </div>
                        </div>
                        <div class="col-6">
                            <h6 class="font-mono fw-bold mb-3" style="font-size:0.72rem; letter-spacing:0.14em; text-transform:uppercase; color:#B88E2D;">Portals</h6>
                            <div class="d-flex flex-column gap-2">
                                <a href="/admin" class="ms-footer-link fw-semibold" style="color:#B88E2D !important;"><i class="bi bi-shop me-2"></i>@Lang["Nav_RestoAdmin"]</a>
                                <a href="/control-admin" class="ms-footer-link fw-semibold" style="color:#B88E2D !important;"><i class="bi bi-sliders2 me-2"></i>@Lang["Nav_ControlPlane"]</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Bottom bar -->
            <div class="mt-5 pt-4 d-flex flex-wrap align-items-center justify-content-between gap-3"
                 style="border-top: 1px solid rgba(184,142,45,0.18);">
                <span class="font-mono" style="font-size:0.72rem; color:var(--ms-text-dim);">
                    &copy; 2026 SiBangku SaaS Platform. All rights reserved.
                </span>
                <span class="font-mono d-inline-flex align-items-center gap-1" style="font-size:0.72rem; color:var(--ms-text-dim);">
                    <span style="width:6px;height:6px;border-radius:50%;background:#059669;display:inline-block;"></span>
                    All systems operational
                </span>
            </div>
        </div>
    </footer>
</div>

<!-- Language Selector Modal -->
<LanguageSelectorModal IsOpen="IsLanguageSelectorOpen"
                       OnClose="() => IsLanguageSelectorOpen = false" />

@code {
    private bool IsLanguageSelectorOpen = false;

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string>("SiBangkuLang.getLanguage");
                if (!string.IsNullOrEmpty(stored) && stored != Lang.CurrentLanguage)
                {
                    Lang.SetLanguage(stored);
                }
            }
            catch { }

            try
            {
                await JS.InvokeVoidAsync("SiBangkuScroll.init");
            }
            catch { }

            try
            {
                await JS.InvokeVoidAsync("SiBangkuLayout.init");
            }
            catch { }
        }
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= HandleLanguageChanged;
    }

    private static string GetFlagEmoji(string code) => (code ?? "").ToLowerInvariant() switch
    {
        "id" => "🇮🇩", "en" => "🇬🇧", "ms" => "🇲🇾", "jv" => "🇮🇩", "su" => "🇮🇩",
        "zh" => "🇨🇳", "ja" => "🇯🇵", "ko" => "🇰🇷", "ar" => "🇸🇦", "fr" => "🇫🇷",
        "de" => "🇩🇪", "es" => "🇪🇸", "ru" => "🇷🇺", "it" => "🇮🇹", "pt" => "🇧🇷",
        "nl" => "🇳🇱", "th" => "🇹🇭", "vi" => "🇻🇳",
        _ => "🌐"
    };
}