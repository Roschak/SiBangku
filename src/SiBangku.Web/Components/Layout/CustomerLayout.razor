@inherits LayoutComponentBase
@implements IDisposable
@inject LanguageService Lang
@inject IJSRuntime JS

<!-- Top Glowing Champagne Scroll Progress Indicator -->
<div id="sibangku-scroll-progress"></div>

<!-- Floating Luxury Back-to-Top Button with Circular Progress Ring -->
<button id="sibangku-back-to-top" type="button" aria-label="Kembali ke atas" onclick="window.SiBangkuScroll ? window.SiBangkuScroll.scrollToTop() : window.scrollTo({top:0,behavior:'smooth'})">
    <svg class="progress-ring" viewBox="0 0 48 48">
        <circle class="progress-ring-circle" cx="24" cy="24" r="22"></circle>
    </svg>
    <i class="bi bi-arrow-up"></i>
</button>

<!-- Floating Section Quick-Jump Rail for Desktop -->
<aside id="sibangku-quick-jump-rail" class="ms-quick-jump-rail d-none d-xl-flex" aria-label="Navigasi Bagian Cepat">
    <div class="ms-quick-jump-track"></div>
    <div class="ms-quick-jump-thumb" id="quick-jump-thumb"></div>
    <a href="#hero" class="ms-quick-jump-dot active" data-target="#hero" title="Beranda">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#simulasi" class="ms-quick-jump-dot" data-target="#simulasi" title="Denah Meja">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#keunggulan" class="ms-quick-jump-dot" data-target="#keunggulan" title="Keunggulan">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#alur" class="ms-quick-jump-dot" data-target="#alur" title="Cara Kerja">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#teknologi" class="ms-quick-jump-dot" data-target="#teknologi" title="Teknologi">
        <span class="ms-quick-jump-inner"></span>
    </a>
    <a href="#cta" class="ms-quick-jump-dot" data-target="#cta" title="Mulai Reservasi">
        <span class="ms-quick-jump-inner"></span>
    </a>
</aside>

<div class="ms-customer-portal d-flex flex-column min-vh-100">
    <!-- Editorial Luxury Navigation Bar (Warm Frosted Glass + Champagne Hairline) -->
    <header class="ms-public-navbar py-3 px-3 px-lg-4 sticky-top">
        <div class="container d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-4">
                <!-- Official SiBangku Brand Logo (Gold on Espresso Mark with Dark Typography) -->
                <a href="/" class="text-decoration-none d-inline-flex align-items-center">
                    <img src="brand/Navbar-Header-Logo.svg" alt="SiBangku Hospitality" style="height: 40px; width: auto;" />
                </a>

                <nav class="d-none d-lg-flex align-items-center gap-1 ms-2">
                    <NavLink class="ms-public-nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house"></i> @Lang["Nav_Home"]
                    </NavLink>
                    <a class="ms-public-nav-link" href="#simulasi">
                        <i class="bi bi-grid-1x2"></i> @Lang.Get("Nav_Floorplan", "Denah Meja")
                    </a>
                    <a class="ms-public-nav-link" href="#keunggulan">
                        <i class="bi bi-gem"></i> @Lang.Get("Nav_Features", "Keunggulan")
                    </a>
                    <a class="ms-public-nav-link" href="#alur">
                        <i class="bi bi-signpost-split"></i> @Lang.Get("Nav_HowItWorks", "3 Langkah")
                    </a>
                    <a class="ms-public-nav-link" href="#teknologi">
                        <i class="bi bi-cpu"></i> @Lang.Get("Nav_Tech", "Arsitektur")
                    </a>
                    <NavLink class="ms-public-nav-link" href="booking">
                        <i class="bi bi-calendar2-check"></i> @Lang["Nav_Booking"]
                    </NavLink>
                </nav>
            </div>

            <div class="d-flex align-items-center gap-2.5">
                <!-- Language Selector Button -->
                <button type="button"
                        class="btn btn-sm font-mono d-inline-flex align-items-center gap-1.5 px-3 py-1.5"
                        style="background: #FFFFFF; border: 1px solid rgba(184, 142, 45, 0.30); border-radius: 999px; font-size: 0.78rem; font-weight: 700; color: var(--ms-text-main); box-shadow: 0 2px 6px rgba(45,35,20,0.05); transition: all 0.2s;"
                        @onclick="() => IsLanguageSelectorOpen = true"
                        title="@Lang["Nav_Language"]">
                    <i class="bi bi-globe2" style="color: #B88E2D; font-size: 0.9rem;"></i>
                    <span class="text-uppercase">@Lang.CurrentLanguage</span>
                    <i class="bi bi-chevron-down" style="font-size: 0.6rem; color: var(--ms-text-dim);"></i>
                </button>

                <a href="/booking" class="ms-btn ms-btn-primary ms-btn-sm text-nowrap d-none d-sm-inline-flex gold-shimmer-btn">
                    <i class="bi bi-calendar-plus me-1"></i>
                    <span>@Lang["Nav_BookNow"]</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- High-End Hospitality Footer (Warm Alabaster) -->
    <footer class="py-5 mt-auto" style="background-color: #F4EFE6; border-top: 1px solid rgba(184, 142, 45, 0.20);">
        <div class="container py-2">
            <div class="row g-4 align-items-center justify-content-between">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center gap-2 justify-content-center justify-content-md-start mb-2">
                        <img src="brand/Navbar-Header-Logo.svg" alt="SiBangku" style="height: 36px; width: auto;" />
                    </div>
                    <p class="small mb-0" style="color: var(--ms-text-muted); max-width: 480px; line-height: 1.7;">
                        @Lang["Footer_Description"]
                    </p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="d-flex flex-wrap justify-content-center justify-content-md-end gap-3 small mb-2.5">
                        <a href="/" class="text-decoration-none" style="color: var(--ms-text-muted);">@Lang["Nav_Home"]</a>
                        <span style="color: rgba(184, 142, 45, 0.35);">•</span>
                        <a href="#simulasi" class="text-decoration-none" style="color: var(--ms-text-muted);">@Lang.Get("Nav_Floorplan", "Denah Meja")</a>
                        <span style="color: rgba(184, 142, 45, 0.35);">•</span>
                        <a href="#alur" class="text-decoration-none" style="color: var(--ms-text-muted);">@Lang.Get("Nav_HowItWorks", "Alur Pemesanan")</a>
                        <span style="color: rgba(184, 142, 45, 0.35);">•</span>
                        <a href="/booking" class="text-decoration-none" style="color: var(--ms-text-muted);">@Lang["Nav_Booking"]</a>
                    </div>
                    <!-- Discreet portal links for clients & owner -->
                    <div class="d-flex flex-wrap justify-content-center justify-content-md-end gap-2 font-mono" style="font-size: 0.75rem;">
                        <span style="color: var(--ms-text-dim);">Portals:</span>
                        <a href="/admin" class="text-decoration-none fw-semibold" style="color: var(--ms-gold);" title="Portal Mitra Restoran">@Lang["Nav_RestoAdmin"]</a>
                        <span style="color: rgba(184, 142, 45, 0.35);">/</span>
                        <a href="/control-admin" class="text-decoration-none fw-semibold" style="color: var(--ms-gold);" title="Platform Control Panel">@Lang["Nav_ControlPlane"]</a>
                    </div>
                    <div class="font-mono mt-2" style="font-size: 0.72rem; color: var(--ms-text-dim);">
                        &copy; 2026 SiBangku SaaS Platform. All rights reserved.
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>

<!-- Language Selector Modal -->
<LanguageSelectorModal IsOpen="IsLanguageSelectorOpen"
                       OnClose="() => IsLanguageSelectorOpen = false" />

@code {
    private bool IsLanguageSelectorOpen = false;

    protected override void OnInitialized()
    {
        Lang.OnLanguageChanged += HandleLanguageChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var stored = await JS.InvokeAsync<string>("SiBangkuLang.getLanguage");
                if (!string.IsNullOrEmpty(stored) && stored != Lang.CurrentLanguage)
                {
                    Lang.SetLanguage(stored);
                }
            }
            catch { }

            try
            {
                await JS.InvokeVoidAsync("SiBangkuScroll.init");
            }
            catch { }
        }
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Lang.OnLanguageChanged -= HandleLanguageChanged;
    }
}