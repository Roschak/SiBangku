<!-- Public Outlets Directory Modal (Privacy-Preserving & Synchronized) -->
@if (IsDirectoryModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(45, 35, 20, 0.65); backdrop-filter: blur(6px); z-index: 1060;">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="background: #FFFFFF; border: 1px solid rgba(184, 142, 45, 0.40); border-radius: 16px; box-shadow: 0 24px 60px -15px rgba(45,35,20,0.30); overflow: hidden;">
                <div class="modal-header px-4 py-3" style="border-bottom: 1px solid rgba(184, 142, 45, 0.18); background: #FAF8F5;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 38px; height: 38px; background: rgba(184, 142, 45, 0.12); color: #B88E2D;">
                            <i class="bi bi-compass fs-5"></i>
                        </span>
                        <div>
                            <h5 class="modal-title ms-serif fw-bold mb-0" style="color: var(--ms-text-main);">Direktori Outlet Restoran</h5>
                            <span class="font-mono text-muted" style="font-size: 0.72rem;">Daftar mitra aktif & demo resmi platform SiBangku</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => IsDirectoryModalOpen = false"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Search & Filter Tabs -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-7">
                            <div class="ms-input-group">
                                <i class="bi bi-search ms-input-icon"></i>
                                <input type="text" class="ms-form-control has-icon-left font-mono"
                                       @bind="DirectorySearchQuery" @bind:event="oninput"
                                       placeholder="Cari nama atau kode outlet..."
                                       style="font-size: 0.82rem; border-radius: 10px;" />
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-sm @(DirectoryTab == "ALL" ? "btn-dark" : "btn-outline-secondary") font-mono"
                                        style="font-size: 0.72rem; border-radius: 8px 0 0 8px;" @onclick='() => DirectoryTab = "ALL"'>
                                    Semua (@FilteredOutlets.Count)
                                </button>
                                <button type="button" class="btn btn-sm @(DirectoryTab == "ACTIVE" ? "btn-dark" : "btn-outline-secondary") font-mono"
                                        style="font-size: 0.72rem;" @onclick='() => DirectoryTab = "ACTIVE"'>
                                    Berlangganan (@SubscribedOutlets.Count)
                                </button>
                                <button type="button" class="btn btn-sm @(DirectoryTab == "TRIAL" ? "btn-dark" : "btn-outline-secondary") font-mono"
                                        style="font-size: 0.72rem; border-radius: 0 8px 8px 0;" @onclick='() => DirectoryTab = "TRIAL"'>
                                    Demo (@DemoOutlets.Count)
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Privacy Shield Guarantee Notice -->
                    <div class="p-2 px-3 mb-3 font-mono rounded" style="font-size: 0.72rem; background: rgba(184, 142, 45, 0.08); color: var(--ms-text-dim); border: 1px solid rgba(184, 142, 45, 0.18);">
                        <i class="bi bi-shield-lock me-1" style="color: #B88E2D;"></i>
                        <strong>Privasi Terlindungi:</strong> Informasi sensitif (alamat email pemilik, kredensial DB, histori invoice) diisolasi terpisah dan tidak ditampilkan pada publik.
                    </div>

                    <!-- Outlets Dynamic List -->
                    @if (IsLoadingOutlets)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-warning me-2" role="status"></div>
                            <span class="font-mono small text-muted">Menyinkronkan data outlet dengan server...</span>
                        </div>
                    }
                    else if (!FilteredOutlets.Any())
                    {
                        <div class="text-center py-4 text-muted font-mono">
                            <i class="bi bi-shop-window d-block fs-3 mb-2" style="color: #B88E2D;"></i>
                            <p class="small mb-0">Tidak ada outlet yang sesuai dengan kategori ini.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group gap-2" style="max-height: 380px; overflow-y: auto;">
                            @foreach (var o in FilteredOutlets)
                            {
                                var isTrial = o.Status.Equals("TRIAL", StringComparison.OrdinalIgnoreCase);
                                <div class="list-group-item d-flex align-items-center justify-content-between p-3 rounded"
                                     style="background: #FFFFFF; border: 1px solid rgba(184, 142, 45, 0.22); border-radius: 12px !important;">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                             style="width: 42px; height: 42px; background: @(isTrial ? "rgba(217, 119, 6, 0.12)" : "rgba(16, 185, 129, 0.12)"); color: @(isTrial ? "#D97706" : "#10B981");">
                                            <i class="bi @(isTrial ? "bi-stars" : "bi-patch-check-fill") fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="ms-serif fw-bold mb-0" style="color: var(--ms-text-main); font-size: 0.98rem;">@o.RestaurantName</h6>
                                            <div class="d-flex align-items-center gap-2 font-mono mt-1" style="font-size: 0.70rem;">
                                                <span class="badge @(isTrial ? "bg-warning-subtle text-warning" : "bg-success-subtle text-success") px-2 py-0.5" style="border-radius: 6px;">
                                                    @(isTrial ? "DEMO OUTLET (TRIAL)" : "BERLANGGANAN AKTIF")
                                                </span>
                                                <span class="text-muted">Kode: <strong style="color: var(--ms-text-main);">@o.TenantCode</strong></span>
                                            </div>
                                        </div>
                                    </div>
                                    <button type="button" class="ms-btn ms-btn-primary ms-btn-sm font-mono text-nowrap gold-shimmer-btn"
                                            style="border-radius: 10px; font-size: 0.75rem;"
                                            @onclick="() => SelectDemoOutlet(o.TenantCode)">
                                        <span>Kunjungi</span>
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer px-4 py-2.5" style="background: #FAF8F5; border-top: 1px solid rgba(184, 142, 45, 0.18);">
                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm px-3" style="border-radius: 8px;" @onclick="() => IsDirectoryModalOpen = false">
                        Tutup
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string SearchTenantCode = "";
    private string? SearchError;
    private bool IsScannerOpen = false;
    private int SelectedDemoTable = 1;
    private string SelectedDemoTableNumber = "Meja 01";

    private bool IsDirectoryModalOpen = false;
    private bool IsLoadingOutlets = false;
    private string DirectorySearchQuery = "";
    private string DirectoryTab = "ALL";

    public record PublicOutletDto(string TenantCode, string RestaurantName, string Status);
    private List<PublicOutletDto> AllOutlets = new();

    private List<PublicOutletDto> DemoOutlets => AllOutlets
        .Where(o => o.Status.Equals("TRIAL", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<PublicOutletDto> SubscribedOutlets => AllOutlets
        .Where(o => o.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<PublicOutletDto> FilteredOutlets
    {
        get
        {
            var query = AllOutlets.AsEnumerable();
            if (DirectoryTab == "ACTIVE")
            {
                query = query.Where(o => o.Status.Equals("ACTIVE", StringComparison.OrdinalIgnoreCase));
            }
            else if (DirectoryTab == "TRIAL")
            {
                query = query.Where(o => o.Status.Equals("TRIAL", StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(DirectorySearchQuery))
            {
                var q = DirectorySearchQuery.Trim().ToLowerInvariant();
                query = query.Where(o => o.RestaurantName.ToLowerInvariant().Contains(q) || o.TenantCode.ToLowerInvariant().Contains(q));
            }
            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Lang.OnLanguageChanged += HandleLanguageChanged;
        await LoadPublicOutletsAsync();
    }

    private async Task LoadPublicOutletsAsync()
    {
        IsLoadingOutlets = true;
        try
        {
            var client = ClientFactory.CreateClient("ControlApi");
            var res = await client.GetFromJsonAsync<PublicOutletsResponse>("/api/v1/public/outlets");
            if (res != null && res.Success && res.Data != null)
            {
                AllOutlets = res.Data.Select(d => new PublicOutletDto(d.TenantCode ?? "", d.RestaurantName ?? "", d.Status ?? "ACTIVE")).ToList();
            }
        }
        catch
        {
            // Fallback default demo outlets if ControlApi is seeding or unreachable
        }
        finally
        {
            if (!AllOutlets.Any())
            {
                AllOutlets = new List<PublicOutletDto>
                {
                    new PublicOutletDto("GRAND-BISTRO", "Grand Bistro Dining & Lounge", "ACTIVE"),
                    new PublicOutletDto("WARUNG-SEDAP", "Warung Sedap Nusantara", "TRIAL"),
                    new PublicOutletDto("KOPI-SENJA", "Kopi Senja Artisan Cafe", "TRIAL")
                };
            }
            IsLoadingOutlets = false;
        }
    }

    private class PublicOutletsResponse
    {
        public bool Success { get; set; }
        public List<PublicOutletItem>? Data { get; set; }
    }

    private class PublicOutletItem
    {
        public string? TenantCode { get; set; }
        public string? RestaurantName { get; set; }
        public string? Status { get; set; }
    }

    private IJSObjectReference? _threeModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("SiBangkuAnime.initLandingAnimations");
            }
            catch { }

            // The Three.js scene (~2 MB) is imported on demand from this page only,
            // so no other portal pays for it.
            try
            {
                _threeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sibangku-three.js");
                await _threeModule.InvokeVoidAsync("initHeroScene", "sibangku-hero-canvas");
            }
            catch
            {
                // WebGL unavailable or module blocked: the CSS gradient fallback remains.
            }
        }
    }

    private void HandleLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SelectDemoTable(string tableNum, int id)
    {
        SelectedDemoTableNumber = tableNum;
        SelectedDemoTable = id;
    }

    private (string Zone, string Ambiance, int Seats, string MinSpend) GetTableInfo(int tableNum) => tableNum switch
    {
        1 => ("VIP Suite", "Privat, Sofa Mewah, Lampu Gantung Warm Amber", 6, "Rp 500.000"),
        2 => ("Main Hall", "Intimate Candlelight, Meja Berdua Romantis", 2, "Bebas Min. Order"),
        3 => ("Main Hall", "Meja Bundar Tengah, Nuansa Santai", 4, "Bebas Min. Order"),
        4 => ("Main Hall", "Meja Keluarga Nyaman, Dekat Lorong Utama", 6, "Bebas Min. Order"),
        5 => ("Skyline Terrace", "Pemandangan Jendela Luar, Angin Semilir", 2, "Bebas Min. Order"),
        6 => ("Skyline Terrace", "Balkon Terbuka, Pemandangan Lampu Kota", 4, "Bebas Min. Order"),
        _ => ("Main Hall", "Suasana Santap Eksklusif", 4, "Bebas Min. Order")
    };

    private void SelectDemoOutlet(string code)
    {
        IsDirectoryModalOpen = false;
        SearchTenantCode = code;
        SearchError = null;
        Navigation.NavigateTo($"/booking?tenant={code}");
    }

    private void NavigateToBooking()
    {
        SearchError = null;
        if (string.IsNullOrWhiteSpace(SearchTenantCode))
        {
            SearchError = Lang["Booking_Search_Placeholder"];
            return;
        }

        Navigation.NavigateTo($"/booking?tenant={SearchTenantCode.Trim().ToUpperInvariant()}");
    }

    private void HandleQrScanned(string code)
    {
        IsScannerOpen = false;
        if (!string.IsNullOrWhiteSpace(code))
        {
            Navigation.NavigateTo($"/booking?tenant={code.Trim().ToUpperInvariant()}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Lang.OnLanguageChanged -= HandleLanguageChanged;

        if (_threeModule is not null)
        {
            try
            {
                await _threeModule.InvokeVoidAsync("disposeHeroScene");
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }

            try
            {
                await _threeModule.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
            catch (TaskCanceledException) { }
        }
    }
}