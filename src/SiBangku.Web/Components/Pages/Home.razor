@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject LanguageService Lang
@inject IJSRuntime JS
@inject IHttpClientFactory ClientFactory

<PageTitle>SiBangku - @Lang["Hero_Title_1"]</PageTitle>

<!-- SiBangku Customer Experience — Warm Silk × Champagne Gold -->
<div class="position-relative overflow-hidden" style="background-color: var(--ms-body-bg);">
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- 1. HERO — FULLSCREEN VIDEO BACKGROUND                             -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <section id="hero" class="hero-bg-section">

        <!-- Background video (cursor-controlled currentTime) -->
        <div class="hero-bg-video-wrap" aria-hidden="true">
            <video id="heroBgVideo" class="hero-bg-video"
                   src="/video/video-transisisibangku.mp4"
                   autoplay muted loop playsinline preload="auto"
                   disablepictureinpicture disableremoteplayback></video>
            <div class="hero-bg-overlay" aria-hidden="true"></div>
            <div class="hero-bg-fade-bottom" aria-hidden="true"></div>
        </div>

        <!-- Hero content -->
        <div class="hero-content-layer">
            <div class="container text-center mx-auto" style="max-width: 820px;">

                <!-- Eyebrow -->
                <div class="hero-badge-reveal mb-4">
                    <span class="hero-eyebrow-badge font-mono">
                        <span class="hero-eyebrow-dot"></span>
                        @Lang.Get("Hero_Eyebrow", "Fine Dining Reservation & Table Management")
                    </span>
                </div>

                <!-- Headline -->
                <h1 class="hero-title-reveal ms-serif fw-bold mb-3">
                    @Lang["Hero_Title_1"]<br />
                    <em class="hero-title-gold">@Lang["Hero_Title_2"]</em>
                </h1>

                <!-- Gold divider -->
                <div class="hero-gold-line mx-auto mb-4"></div>

                <!-- Subtitle -->
                <p class="hero-desc-reveal mx-auto mb-5">@Lang["Hero_Subtitle"]</p>

                <!-- Search bar -->
                <div class="hero-action-reveal mb-3 mx-auto" style="max-width: 560px;">
                    @if (!string.IsNullOrEmpty(SearchError))
                    {
                        <div class="ms-alert ms-alert-danger mb-3 py-2 px-3 small text-start">
                            <i class="bi bi-exclamation-octagon ms-alert-icon"></i>
                            <div class="ms-alert-content">@SearchError</div>
                        </div>
                    }
                    <div class="hero-search-bar">
                        <form @onsubmit="NavigateToBooking" class="d-flex gap-2">
                            <div class="ms-input-group flex-grow-1">
                                <i class="bi bi-search ms-input-icon" style="color:#B88E2D;"></i>
                                <input type="text" class="ms-form-control has-icon-left font-mono text-uppercase border-0"
                                       @bind="SearchTenantCode"
                                       placeholder="@Lang["Hero_Search_Placeholder"]"
                                       style="background:transparent;font-size:.86rem;font-weight:600;box-shadow:none;color:#FAF8F5;" />
                            </div>
                            <button type="submit" class="ms-btn ms-btn-primary ms-btn-sm text-nowrap px-4 gold-shimmer-btn" style="border-radius:12px;">
                                <span>@Lang["Hero_Search_Btn"]</span>
                                <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </form>
                    </div>

                    <!-- Demo chips -->
                    <div class="mt-3 d-flex flex-wrap justify-content-center align-items-center gap-2">
                        <span class="font-mono" style="font-size:.72rem;color:rgba(243,232,200,.65);">
                            <i class="bi bi-shop-window me-1" style="color:#D4AF37;"></i>@Lang.Get("Demo_Try", "Coba Demo:")
                        </span>
                        @if (DemoOutlets.Any())
                        {
                            @foreach (var outlet in DemoOutlets.Take(4))
                            {
                                <button type="button" class="hero-demo-chip" @onclick='() => SelectDemoOutlet(outlet.TenantCode)'>
                                    <i class="bi bi-stars" style="color:#D4AF37;"></i>
                                    <span>@outlet.RestaurantName</span>
                                </button>
                            }
                        }
                        <button type="button" class="hero-demo-chip hero-demo-chip--gold" @onclick="() => IsDirectoryModalOpen = true">
                            <i class="bi bi-compass"></i>
                            <span>@Lang.Get("Demo_Directory", "Direktori") (@AllOutlets.Count)</span>
                        </button>
                    </div>
                </div>

                <!-- Action buttons -->
                <div class="hero-action-reveal d-flex flex-wrap justify-content-center gap-3 mt-2">
                    <button type="button" class="hero-action-btn hero-action-btn--ghost" @onclick="() => IsScannerOpen = true">
                        <i class="bi bi-camera"></i>
                        <span>@Lang["Hero_Btn_ScanQR"]</span>
                    </button>
                    <a href="/booking" class="hero-action-btn hero-action-btn--gold gold-shimmer-btn">
                        <i class="bi bi-calendar-check"></i>
                        <span>@Lang["Hero_Btn_Book"]</span>
                    </a>
                    <a href="/admin" class="hero-action-btn hero-action-btn--ghost font-mono" style="font-size:.8rem;">
                        <i class="bi bi-shop"></i>
                        <span>@Lang["Hero_Btn_RestoPortal"]</span>
                    </a>
                </div>

                <!-- Scroll hint -->
                <div class="hero-scroll-hint mt-5" aria-hidden="true">
                    <span class="hero-scroll-line"></span>
                    <span class="font-mono" style="font-size:.68rem;letter-spacing:.18em;color:rgba(243,232,200,.45);">SCROLL</span>
                </div>

            </div>
        </div>
    </section>

    <!-- Main page content -->
    <div class="position-relative" style="background-color:var(--ms-body-bg);">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 2. SIMULASI DENAH                                             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <section id="simulasi" class="observe-section observe-interactive-mockup section-block">
            <div class="container">
                <!-- Section header -->
                <div class="text-center mx-auto mb-5 sr-fade-up" style="max-width:680px;">
                    <span class="section-eyebrow mb-3 d-inline-flex">
                        <i class="bi bi-grid-3x3-gap-fill"></i> @Lang.Get("Mockup_Badge", "SIMULASI DENAH RESTORAN")
                    </span>
                    <h2 class="section-title mt-3 mb-3">@Lang.Get("Mockup_Title", "Eksplorasi Denah & Alur Pemilihan Meja")</h2>
                    <div class="ms-scroll-divider"></div>
                    <p class="section-subtitle">@Lang.Get("Mockup_Subtitle", "Klik meja di bawah ini untuk melihat zonasi ruang, estimasi suasana, dan alur pemesanan langsung.")</p>
                </div>

                <!-- Floorplan card -->
                <div class="hero-preview-reveal ms-card p-3 p-md-4 mx-auto sr-scale"
                     style="max-width:960px;background:#FFFFFF;border:1px solid rgba(184,142,45,.28);border-radius:20px;box-shadow:0 20px 60px -20px rgba(45,35,20,.12);">

                    <!-- Header bar -->
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3"
                         style="border-bottom:1px solid rgba(184,142,45,.15);">
                        <div class="d-flex align-items-center gap-3">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-3 flex-shrink-0"
                                  style="width:40px;height:40px;font-size:1.1rem;background:rgba(184,142,45,.1);border:1px solid rgba(184,142,45,.35);border-radius:10px;color:#B88E2D;">
                                <i class="bi bi-diagram-2"></i>
                            </span>
                            <div>
                                <strong class="d-block ms-serif" style="color:var(--ms-text-main);font-size:1rem;">@Lang.Get("Mockup_Main_Plan", "Denah Meja Utama — Grand Bistro")</strong>
                                <span class="font-mono" style="font-size:.7rem;color:var(--ms-text-dim);">@Lang.Get("Mockup_Capacity_Subtitle", "Kapasitas: 24 Kursi • 3 Zona Bersantap")</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap font-mono" style="font-size:.68rem;">
                            <span class="badge bg-transparent border border-success text-success px-2 py-1"><i class="bi bi-circle-fill me-1" style="font-size:.45rem;"></i>@Lang.Get("Mockup_Status_Available", "Tersedia") (4)</span>
                            <span class="badge bg-transparent border border-warning text-warning px-2 py-1"><i class="bi bi-clock-fill me-1" style="font-size:.45rem;"></i>@Lang.Get("Mockup_Status_Hold", "Hold") (1)</span>
                            <span class="badge bg-transparent border border-danger text-danger px-2 py-1"><i class="bi bi-lock-fill me-1" style="font-size:.45rem;"></i>@Lang.Get("Mockup_Status_Booked", "Terisi") (1)</span>
                        </div>
                    </div>

                    <!-- Zones -->
                    <div class="row g-3 mb-4">
                        <div class="col-lg-4 col-md-6">
                            <div class="floorplan-zone-card h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="font-mono fw-bold" style="font-size:.7rem;color:#B88E2D;letter-spacing:.1em;"><i class="bi bi-star-fill me-1"></i>@Lang.Get("Mockup_Zone_VIP", "ZONA VIP SUITE")</span>
                                    <span class="badge bg-light text-muted border font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Tag_Private", "Privat")</span>
                                </div>
                                <div class="table-sim-luxury @(SelectedDemoTable == 1 ? "is-selected" : "")" @onclick='() => SelectDemoTable("Meja 01", 1)'>
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <span class="font-mono fw-bold" style="font-size:.84rem;color:var(--ms-text-main);">Meja 01</span>
                                        <span class="badge bg-success-subtle text-success font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Table_Ready", "Siap")</span>
                                    </div>
                                    <div class="small font-mono text-muted mb-2" style="font-size:.7rem;">@Lang.Get("Mockup_Table_1_Desc", "Sofa Booth Mewah • 6 Kursi")</div>
                                    <div class="chair-indicator-dots">
                                        <span class="chair-dot"></span><span class="chair-dot"></span><span class="chair-dot"></span>
                                        <span class="chair-dot"></span><span class="chair-dot"></span><span class="chair-dot"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-6">
                            <div class="floorplan-zone-card h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="font-mono fw-bold" style="font-size:.7rem;color:#B88E2D;letter-spacing:.1em;"><i class="bi bi-cup-straw me-1"></i>@Lang.Get("Mockup_Zone_Main", "MAIN DINING HALL")</span>
                                    <span class="badge bg-light text-muted border font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Tag_Lobby", "Lobby")</span>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    <div class="table-sim-luxury @(SelectedDemoTable == 2 ? "is-selected" : "")" @onclick='() => SelectDemoTable("Meja 02", 2)'>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="font-mono fw-bold" style="font-size:.84rem;color:var(--ms-text-main);">Meja 02</span>
                                            <span class="badge bg-success-subtle text-success font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Table_Ready", "Siap")</span>
                                        </div>
                                        <div class="small font-mono text-muted mb-1" style="font-size:.7rem;">@Lang.Get("Mockup_Table_2_Desc", "Intimate Candlelight • 2 Kursi")</div>
                                        <div class="chair-indicator-dots"><span class="chair-dot"></span><span class="chair-dot"></span></div>
                                    </div>
                                    <div class="table-sim-luxury is-booked" title="Sedang digunakan">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="font-mono fw-bold" style="font-size:.84rem;color:#DC2626;">Meja 03</span>
                                            <span class="badge bg-danger-subtle text-danger font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Table_Occupied", "Terisi")</span>
                                        </div>
                                        <div class="small font-mono text-muted mb-1" style="font-size:.7rem;">@Lang.Get("Mockup_Table_3_Desc", "Family Table • 4 Kursi")</div>
                                        <div class="chair-indicator-dots">
                                            <span class="chair-dot" style="background:rgba(220,38,38,.4);"></span><span class="chair-dot" style="background:rgba(220,38,38,.4);"></span>
                                            <span class="chair-dot" style="background:rgba(220,38,38,.4);"></span><span class="chair-dot" style="background:rgba(220,38,38,.4);"></span>
                                        </div>
                                    </div>
                                    <div class="table-sim-luxury @(SelectedDemoTable == 4 ? "is-selected" : "")" @onclick='() => SelectDemoTable("Meja 04", 4)'>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="font-mono fw-bold" style="font-size:.84rem;color:var(--ms-text-main);">Meja 04</span>
                                            <span class="badge bg-success-subtle text-success font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Table_Ready", "Siap")</span>
                                        </div>
                                        <div class="small font-mono text-muted mb-1" style="font-size:.7rem;">@Lang.Get("Mockup_Table_4_Desc", "Center Dining • 6 Kursi")</div>
                                        <div class="chair-indicator-dots">
                                            <span class="chair-dot"></span><span class="chair-dot"></span><span class="chair-dot"></span>
                                            <span class="chair-dot"></span><span class="chair-dot"></span><span class="chair-dot"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4 col-md-12">
                            <div class="floorplan-zone-card h-100">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="font-mono fw-bold" style="font-size:.7rem;color:#B88E2D;letter-spacing:.1em;"><i class="bi bi-brightness-high me-1"></i>@Lang.Get("Mockup_Zone_Skyline", "SKYLINE TERRACE")</span>
                                    <span class="badge bg-light text-muted border font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Tag_Outdoor", "Outdoor")</span>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    <div class="table-sim-luxury is-hold" title="Hold reservasi 15 menit">
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="font-mono fw-bold" style="font-size:.84rem;color:#D97706;">Meja 05</span>
                                            <span class="badge bg-warning-subtle text-warning font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Table_Hold_15m", "Hold 15m")</span>
                                        </div>
                                        <div class="small font-mono text-muted mb-1" style="font-size:.7rem;">@Lang.Get("Mockup_Table_5_Desc", "Glass Window Side • 2 Kursi")</div>
                                        <div class="chair-indicator-dots">
                                            <span class="chair-dot" style="background:rgba(217,119,6,.4);"></span><span class="chair-dot" style="background:rgba(217,119,6,.4);"></span>
                                        </div>
                                    </div>
                                    <div class="table-sim-luxury @(SelectedDemoTable == 6 ? "is-selected" : "")" @onclick='() => SelectDemoTable("Meja 06", 6)'>
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <span class="font-mono fw-bold" style="font-size:.84rem;color:var(--ms-text-main);">Meja 06</span>
                                            <span class="badge bg-success-subtle text-success font-mono" style="font-size:.62rem;">@Lang.Get("Mockup_Table_Ready", "Siap")</span>
                                        </div>
                                        <div class="small font-mono text-muted mb-1" style="font-size:.7rem;">@Lang.Get("Mockup_Table_6_Desc", "Outdoor Balcony • 4 Kursi")</div>
                                        <div class="chair-indicator-dots">
                                            <span class="chair-dot"></span><span class="chair-dot"></span><span class="chair-dot"></span><span class="chair-dot"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Selected table info -->
                    @{var tableInfo = GetTableInfo(SelectedDemoTable);}
                    <div class="p-3 rounded-3" style="background:rgba(184,142,45,.07);border:1px solid rgba(184,142,45,.28);">
                        <div class="row align-items-center g-3">
                            <div class="col-md-3">
                                <span class="d-block font-mono" style="font-size:.65rem;color:var(--ms-text-dim);">@Lang.Get("Mockup_Selected_Table", "MEJA TERPILIH")</span>
                                <strong class="fs-6 font-mono" style="color:var(--ms-text-main);">@SelectedDemoTableNumber (@tableInfo.Zone)</strong>
                            </div>
                            <div class="col-md-3">
                                <span class="d-block font-mono" style="font-size:.65rem;color:var(--ms-text-dim);">@Lang.Get("Mockup_Capacity_Spend", "KAPASITAS & MIN. SPEND")</span>
                                <strong class="fs-6 font-mono" style="color:#B88E2D;">@tableInfo.Seats @Lang.Get("Mockup_Seats", "Kursi") • @tableInfo.MinSpend</strong>
                            </div>
                            <div class="col-md-3">
                                <span class="d-block font-mono" style="font-size:.65rem;color:var(--ms-text-dim);">@Lang.Get("Mockup_Ambiance_Feature", "SUASANA & FITUR")</span>
                                <span class="small" style="color:var(--ms-text-muted);">@tableInfo.Ambiance</span>
                            </div>
                            <div class="col-md-3 text-md-end">
                                <a href="/booking?tenant=GRAND-BISTRO" class="ms-btn ms-btn-primary ms-btn-sm w-100 gold-shimmer-btn justify-content-center" style="border-radius:10px;">
                                    <i class="bi bi-calendar2-check me-1"></i>@Lang.Get("Mockup_Book_Action", "Pesan") @SelectedDemoTableNumber
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- 3. KEUNGGULAN                                                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <section id="keunggulan" class="observe-section stat-counter-section section-block" style="background:linear-gradient(180deg,var(--ms-body-bg) 0%,rgba(244,239,230,.6) 100%);">
            <div class="container">
                <div class="text-center mx-auto mb-5 sr-fade-up" style="max-width:680px;">
                    <span class="section-eyebrow mb-3 d-inline-flex">@Lang.Get("Features_Badge", "KEUNGGULAN UTAMA")</span>
                    <h2 class="section-title mt-3 mb-3">@Lang.Get("Features_Title", "Dirancang Presisi untuk Industri Kuliner")</h2>
                    <div class="ms-scroll-divider"></div>
                    <p class="section-subtitle">@Lang.Get("Features_Subtitle", "Fondasi matematis mutakhir yang mengeliminasi kerugian restoran dan memberikan kepastian tempat bagi tamu.")</p>
                </div>

                <!-- Stats row -->
                <div class="row g-4 mb-5 justify-content-center">
                    <div class="col-lg-3 col-sm-6 sr-fade-up delay-1">
                        <div class="stat-counter-card h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-number-glow stat-counter-value" data-target="100" data-suffix="%">100%</div>
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                     style="width:44px;height:44px;background:rgba(184,142,45,.1);border:1px solid rgba(184,142,45,.28);color:#B88E2D;font-size:1.2rem;">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                            </div>
                            <h6 class="ms-serif fw-bold mb-1" style="color:var(--ms-text-main);">@Lang["Hero_Stat_Capacity"]</h6>
                            <p class="small mb-0 font-mono" style="font-size:.73rem;color:var(--ms-text-dim);line-height:1.6;">@Lang["Hero_Stat_Capacity_Sub"]</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 sr-fade-up delay-2">
                        <div class="stat-counter-card h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-number-glow stat-counter-value" data-target="30" data-prefix="< " data-suffix="s">&lt; 30s</div>
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                     style="width:44px;height:44px;background:rgba(184,142,45,.1);border:1px solid rgba(184,142,45,.28);color:#B88E2D;font-size:1.2rem;">
                                    <i class="bi bi-lightning-charge"></i>
                                </div>
                            </div>
                            <h6 class="ms-serif fw-bold mb-1" style="color:var(--ms-text-main);">@Lang["Hero_Stat_Speed"]</h6>
                            <p class="small mb-0 font-mono" style="font-size:.73rem;color:var(--ms-text-dim);line-height:1.6;">@Lang["Hero_Stat_Speed_Sub"]</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 sr-fade-up delay-3">
                        <div class="stat-counter-card h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-number-glow stat-counter-value" data-target="99.9" data-decimals="1" data-suffix="%">99.9%</div>
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                     style="width:44px;height:44px;background:rgba(184,142,45,.1);border:1px solid rgba(184,142,45,.28);color:#B88E2D;font-size:1.2rem;">
                                    <i class="bi bi-diagram-3"></i>
                                </div>
                            </div>
                            <h6 class="ms-serif fw-bold mb-1" style="color:var(--ms-text-main);">@Lang["Hero_Stat_Uptime"]</h6>
                            <p class="small mb-0 font-mono" style="font-size:.73rem;color:var(--ms-text-dim);line-height:1.6;">@Lang["Hero_Stat_Uptime_Sub"]</p>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-6 sr-fade-up delay-4">
                        <div class="stat-counter-card h-100">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <div class="stat-number-glow stat-counter-value" data-target="24" data-suffix="/7">24/7</div>
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                     style="width:44px;height:44px;background:rgba(184,142,45,.1);border:1px solid rgba(184,142,45,.28);color:#B88E2D;font-size:1.2rem;">
                                    <i class="bi bi-calendar2-check"></i>
                                </div>
                            </div>
                            <h6 class="ms-serif fw-bold mb-1" style="color:var(--ms-text-main);">@Lang.Get("Features_Self_Booking", "Reservasi Mandiri")</h6>
                            <p class="small mb-0 font-mono" style="font-size:.73rem;color:var(--ms-text-dim);line-height:1.6;">@Lang.Get("Features_Self_Booking_Sub", "Tamu memesan kapan saja tanpa harus menunggu staf.")</p>
                        </div>
                    </div>
                </div>

                <!-- Product pillars -->
                <div class="row g-4 justify-content-center observe-product-cards">
                    <div class="col-lg-4 col-md-6 sr-fade-up delay-1">
                        <div class="product-feature-card ms-card p-4 h-100" style="background:#FFFFFF;border:1px solid rgba(184,142,45,.18);">
                            <div class="d-flex align-items-center justify-content-between mb-3">
