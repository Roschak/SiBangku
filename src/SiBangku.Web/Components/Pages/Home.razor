@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation

<PageTitle>SiBangku - Enterprise Multi-Tenant Restaurant Reservation Platform</PageTitle>

<div class="container py-4 py-lg-5">
    <!-- Hero Architectural Banner -->
    <div class="ms-card p-4 p-md-5 mb-5" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 mb-3">
                    <span class="ms-badge ms-badge-primary">v3.0.0</span>
                    <span class="font-mono text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">ENTERPRISE MULTI-TENANT HOSPITALITY ENGINE</span>
                </div>

                <h1 class="display-6 fw-bold mb-3" style="letter-spacing: -0.02em; color: var(--ms-text-main); font-weight: 700;">
                    Sistem Reservasi Meja Restoran & Manajemen Multi-Tenant
                </h1>
                <p class="mb-4" style="color: var(--ms-text-muted); font-size: 1rem; max-width: 600px; line-height: 1.6;">
                    Platform perhotelan & kuliner berkecepatan tinggi dengan isolasi basis data fisik, visualisasi denah meja akurat, dan alokasi slot waktu tanpa konflik.
                </p>

                @if (!string.IsNullOrEmpty(SearchError))
                {
                    <div class="ms-alert ms-alert-danger mb-3" style="max-width: 540px;">
                        <i class="bi bi-exclamation-octagon ms-alert-icon"></i>
                        <div class="ms-alert-content">@SearchError</div>
                    </div>
                }

                <!-- Search Outlet Input Bar -->
                <div class="p-1 mb-3" style="background: var(--ms-surface-input); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm); max-width: 540px;">
                    <form @onsubmit="NavigateToBooking" class="d-flex flex-column flex-sm-row gap-2">
                        <div class="ms-input-group flex-grow-1">
                            <i class="bi bi-search ms-input-icon"></i>
                            <input type="text" class="ms-form-control has-icon-left border-0 font-mono text-uppercase" 
                                   @bind="SearchTenantCode" 
                                   placeholder="MASUKKAN KODE OUTLET RESTORAN" 
                                   style="background: transparent; font-size: 0.85rem;" />
                        </div>
                        <button type="submit" class="ms-btn ms-btn-primary ms-btn-sm text-nowrap">
                            <span>Buka Portal Reservasi</span>
                            <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </form>
                </div>

                <div class="font-mono" style="font-size: 0.72rem; color: var(--ms-text-dim);">
                    <span>Masukkan kode restoran untuk melihat ketersediaan denah meja secara real-time.</span>
                </div>
            </div>

            <div class="col-lg-4 d-none d-lg-block">
                <div class="p-3" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                        <span class="ms-badge ms-badge-success">Active Protocol</span>
                        <span class="font-mono text-muted" style="font-size: 0.7rem;">ISOLATED_DB</span>
                    </div>

                    <div class="d-flex flex-column gap-2 mb-3 font-mono" style="font-size: 0.75rem;">
                        <div class="d-flex justify-content-between py-1 px-2" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-xs);">
                            <span style="color: var(--ms-text-dim);">ENGINE</span>
                            <span class="text-white">C# .NET 9 Core</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 px-2" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-xs);">
                            <span style="color: var(--ms-text-dim);">DATABASE</span>
                            <span class="text-white">PostgreSQL Multi-DB</span>
                        </div>
                        <div class="d-flex justify-content-between py-1 px-2" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-xs);">
                            <span style="color: var(--ms-text-dim);">WORKER</span>
                            <span class="text-white">15-Min Auto Release</span>
                        </div>
                    </div>

                    <a href="/booking" class="ms-btn ms-btn-secondary w-100 text-center justify-content-center">
                        <span>Pesan Meja Mandiri</span>
                        <i class="bi bi-arrow-up-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 3 Step Protocol for Guests -->
    <div class="mb-5">
        <div class="mb-3">
            <h4 class="fw-bold mb-1" style="color: var(--ms-text-main); font-size: 1.15rem;">Alur Reservasi Pelanggan</h4>
            <p class="small mb-0" style="color: var(--ms-text-dim);">Proses mandiri 3 langkah dengan konfirmasi instan.</p>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="ms-card h-100 p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="font-mono text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">STEP 01</span>
                        <i class="bi bi-qr-code text-primary fs-5"></i>
                    </div>
                    <h6 class="fw-bold mb-1.5" style="color: var(--ms-text-main);">Pilih Outlet & Tanggal</h6>
                    <p class="small mb-0" style="color: var(--ms-text-muted); line-height: 1.5;">
                        Masukkan kode restoran atau scan QR standee di restoran mitra. Tentukan tanggal kedatangan dan estimasi tamu.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ms-card h-100 p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="font-mono text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">STEP 02</span>
                        <i class="bi bi-clock-history text-primary fs-5"></i>
                    </div>
                    <h6 class="fw-bold mb-1.5" style="color: var(--ms-text-main);">Pilih Slot Waktu</h6>
                    <p class="small mb-0" style="color: var(--ms-text-muted); line-height: 1.5;">
                        Sistem memvalidasi kapasitas meja secara real-time berdasarkan durasi operasional untuk mencegah double-booking.
                    </p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="ms-card h-100 p-3.5">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="font-mono text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">STEP 03</span>
                        <i class="bi bi-ticket-perforated text-primary fs-5"></i>
                    </div>
                    <h6 class="fw-bold mb-1.5" style="color: var(--ms-text-main);">Tiket Digital Terverifikasi</h6>
                    <p class="small mb-0" style="color: var(--ms-text-muted); line-height: 1.5;">
                        Dapatkan kode reservasi unik resmi untuk ditunjukkan kepada staf resepsionis saat kedatangan di restoran.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Core Architecture Highlights -->
    <div class="row g-3 mb-5">
        <div class="col-lg-3 col-sm-6">
            <div class="ms-stat-card h-100">
                <div class="ms-stat-header">
                    <span class="ms-stat-title">Database Terisolasi</span>
                    <div class="ms-stat-icon">
                        <i class="bi bi-database-check"></i>
                    </div>
                </div>
                <div class="ms-stat-value fs-4">Multi-Tenant</div>
                <p class="ms-stat-hint">Setiap mitra restoran memiliki basis data fisik terpisah demi integritas dan kepatuhan privasi.</p>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="ms-stat-card h-100">
                <div class="ms-stat-header">
                    <span class="ms-stat-title">Denah Meja Visual</span>
                    <div class="ms-stat-icon">
                        <i class="bi bi-bounding-box-circles"></i>
                    </div>
                </div>
                <div class="ms-stat-value fs-4">Koordinat X,Y</div>
                <p class="ms-stat-hint">Tata letak meja absolut dengan rotasi derajat untuk representasi denah restoran yang presisi.</p>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="ms-stat-card h-100">
                <div class="ms-stat-header">
                    <span class="ms-stat-title">Worker Scheduler</span>
                    <div class="ms-stat-icon">
                        <i class="bi bi-cpu"></i>
                    </div>
                </div>
                <div class="ms-stat-value fs-4">Auto-Release</div>
                <p class="ms-stat-hint">Daemon worker .NET 9 membatalkan otomatis reservasi yang tidak dikonfirmasi dalam batas waktu 15 menit.</p>
            </div>
        </div>

        <div class="col-lg-3 col-sm-6">
            <div class="ms-stat-card h-100">
                <div class="ms-stat-header">
                    <span class="ms-stat-title">White-Label Branding</span>
                    <div class="ms-stat-icon">
                        <i class="bi bi-sliders"></i>
                    </div>
                </div>
                <div class="ms-stat-value fs-4">Kustomisasi</div>
                <p class="ms-stat-hint">Penyesuaian penuh warna tema, logo, banner, jam operasional, dan poster QR cetak standee.</p>
            </div>
        </div>
    </div>

    <!-- Direct Fast Booking Card -->
    <div class="ms-card p-4 text-center" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
        <h4 class="fw-bold mb-2" style="color: var(--ms-text-main);">Mulai Pemesanan Meja Mandiri</h4>
        <p class="small mb-3" style="color: var(--ms-text-muted); max-width: 500px; margin: 0 auto;">
            Pilih outlet restoran mitra tujuan Anda dan amankan slot meja favorit Anda tanpa antre.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a href="/booking" class="ms-btn ms-btn-primary">
                <i class="bi bi-calendar2-plus me-1"></i> Buka Halaman Pemesanan
            </a>
        </div>
    </div>
</div>

@code {
    private string SearchTenantCode = "";
    private string? SearchError;

    private void NavigateToBooking()
    {
        SearchError = null;
        if (string.IsNullOrWhiteSpace(SearchTenantCode))
        {
            SearchError = "Harap masukkan kode resto tujuan Anda.";
            return;
        }

        Navigation.NavigateTo($"/booking?tenant={SearchTenantCode.Trim().ToUpperInvariant()}");
    }
}
