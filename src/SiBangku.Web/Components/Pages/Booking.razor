@page "/booking"
@rendermode InteractiveServer
@using System.Text.Json
@using SiBangku.Shared.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Portal Reservasi Meja - @(ActiveTenant?.RestaurantName ?? "SiBangku")</PageTitle>

<div class="container py-4 py-lg-5" style="--ms-primary: @Branding.PrimaryColor; --ms-primary-hover: @Branding.SecondaryColor;">
    <!-- Restaurant Selector & Brand Banner -->
    <div class="ms-card p-3.5 mb-4" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="d-inline-flex align-items-center justify-content-center text-primary" 
                     style="width: 44px; height: 44px; font-size: 1.25rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                    <i class="bi bi-shop"></i>
                </div>
                <div>
                    @if (ActiveTenant != null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="fw-bold mb-0 text-white" style="font-size: 1.15rem;">@ActiveTenant.RestaurantName</h5>
                            <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> Outlet Aktif</span>
                        </div>
                        <div class="font-mono mt-0.5" style="font-size: 0.75rem; color: var(--ms-text-dim);">
                            <i class="bi bi-clock me-1 text-primary"></i> Jam Buka: <span class="text-white">@TimeSlots.OpeningTime - @TimeSlots.ClosingTime WIB</span> • Durasi Slot: <span class="text-white">@TimeSlots.SlotDuration Menit</span>
                        </div>
                    }
                    else
                    {
                        <h5 class="fw-bold mb-0 text-white" style="font-size: 1.15rem;">Portal Reservasi Meja Mandiri</h5>
                        <small style="color: var(--ms-text-dim);">Masukkan kode outlet restoran tujuan Anda untuk melihat ketersediaan meja real-time</small>
                    }
                </div>
            </div>

            <!-- Code Search input -->
            <div class="d-flex align-items-center gap-2">
                <div class="ms-input-group">
                    <i class="bi bi-geo-alt ms-input-icon"></i>
                    <input type="text" class="ms-form-control has-icon-left font-mono fw-bold text-uppercase" 
                           @bind="TenantCode" placeholder="KODE RESTORAN" style="max-width: 180px; font-size: 0.85rem;" />
                </div>
                <button class="ms-btn ms-btn-primary ms-btn-sm text-nowrap" @onclick="LoadTenantBranding" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <i class="bi bi-search"></i>
                    }
                    <span>Cari Resto</span>
                </button>
            </div>
        </div>
    </div>

    @if (string.IsNullOrWhiteSpace(TenantCode) && ActiveTenant == null && !IsLoading)
    {
        <!-- Prompt to enter restaurant code -->
        <div class="ms-card p-5 text-center my-4" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
            <div class="d-inline-flex align-items-center justify-content-center text-primary mb-3" 
                 style="width: 52px; height: 52px; font-size: 1.5rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                <i class="bi bi-qr-code-scan"></i>
            </div>
            <h5 class="fw-bold text-white mb-2">Tentukan Outlet Restoran Mitra</h5>
            <p class="small mb-4" style="color: var(--ms-text-muted); max-width: 460px; margin: 0 auto; line-height: 1.5;">
                Silakan masukkan kode restoran pada kolom pencarian di atas atau buka halaman melalui tautan QR Code standee yang tersedia di restoran.
            </p>
        </div>
    }
    else if (IsLoading)
    {
        <div class="ms-card p-5 text-center my-4" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
            <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h6 class="fw-bold text-white mb-1">Menghubungkan ke Basis Data Restoran...</h6>
            <p class="small" style="color: var(--ms-text-dim);">Memvalidasi slot waktu dan alokasi kapasitas meja secara real-time.</p>
        </div>
    }
    else if (ShowSuccessCard && ConfirmedReservation != null)
    {
        <!-- Confirmation Ticket View -->
        <div class="row justify-content-center py-2">
            <div class="col-lg-7 col-md-9">
                <div class="ms-alert ms-alert-success mb-4">
                    <i class="bi bi-check-circle ms-alert-icon"></i>
                    <div class="ms-alert-content">
                        <div class="ms-alert-title">Reservasi Berhasil Dikonfirmasi!</div>
                        <div>Kode booking resmi Anda adalah <strong class="font-mono">@ConfirmedReservation.ReservationNumber</strong>. Simpan tiket digital ini saat kedatangan.</div>
                    </div>
                </div>

                <div class="ms-card overflow-hidden" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
                    <!-- Ticket Header -->
                    <div class="p-4 text-center text-white" style="background: var(--ms-surface-elevated); border-bottom: 1px solid var(--ms-border);">
                        <div class="d-inline-flex align-items-center justify-content-center text-success mb-2" 
                             style="width: 44px; height: 44px; font-size: 1.3rem; background: var(--ms-surface-input); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                            <i class="bi bi-ticket-perforated"></i>
                        </div>
                        <h5 class="fw-bold mb-1">Tiket Reservasi Meja Digital</h5>
                        <p class="small mb-0 font-mono" style="color: var(--ms-text-dim);">Tunjukkan tiket ini kepada staf resepsionis restoran.</p>
                    </div>

                    <!-- Ticket Details -->
                    <div class="p-4 p-md-4.5">
                        <div class="d-flex align-items-center justify-content-between p-3 mb-4 font-mono" 
                             style="background: var(--ms-surface-input); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                            <div>
                                <span class="d-block text-uppercase" style="font-size: 0.68rem; color: var(--ms-text-dim); letter-spacing: 0.05em;">KODE BOOKING</span>
                                <span class="fs-4 fw-bold text-primary font-mono">@ConfirmedReservation.ReservationNumber</span>
                            </div>
                            <span class="ms-badge ms-badge-warning">
                                <span class="ms-badge-dot"></span> Terdaftar
                            </span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="p-3" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                                    <span class="small d-block" style="font-size: 0.72rem; color: var(--ms-text-dim);">Restoran Tujuan</span>
                                    <strong class="text-white">@(ActiveTenant?.RestaurantName ?? TenantCode)</strong>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                                    <span class="small d-block" style="font-size: 0.72rem; color: var(--ms-text-dim);">Nama Pemesan</span>
                                    <strong class="text-white">@BookingName</strong>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                                    <span class="small d-block font-mono" style="font-size: 0.72rem; color: var(--ms-text-dim);">Tanggal & Waktu</span>
                                    <strong class="text-white font-mono">@ConfirmedReservation.Date.ToString("dd MMMM yyyy")</strong>
                                    <div class="small text-primary font-mono fw-bold">@ConfirmedReservation.StartTime.ToString(@"hh\:mm") - @ConfirmedReservation.EndTime.ToString(@"hh\:mm") WIB</div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                                    <span class="small d-block" style="font-size: 0.72rem; color: var(--ms-text-dim);">Jumlah Tamu</span>
                                    <strong class="text-white">@ConfirmedReservation.GuestCount Orang</strong>
                                    <div class="small font-mono" style="color: var(--ms-text-dim);">Kontak: @BookingPhone</div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(ConfirmedReservation.Notes))
                        {
                            <div class="p-3 mb-4" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                                <span class="small d-block" style="font-size: 0.72rem; color: var(--ms-text-dim);"><i class="bi bi-chat-text me-1 text-primary"></i> Catatan Khusus:</span>
                                <div class="small text-white">@ConfirmedReservation.Notes</div>
                            </div>
                        }

                        <!-- Actions -->
                        <div class="d-flex flex-wrap gap-2 justify-content-end pt-3" style="border-top: 1px solid var(--ms-border);">
                            <button class="ms-btn ms-btn-secondary" onclick="window.print()">
                                <i class="bi bi-printer"></i> Cetak Tiket
                            </button>
                            <button class="ms-btn ms-btn-secondary" @onclick="ResetForm">
                                <i class="bi bi-plus-circle"></i> Reservasi Baru
                            </button>
                            <button class="ms-btn ms-btn-primary" @onclick="() => ShowSuccessCard = false">
                                <span>Kembali ke Form</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Booking Form Wizard -->
        @if (!string.IsNullOrEmpty(Message))
        {
            <div class="ms-alert ms-alert-danger mb-4">
                <i class="bi bi-exclamation-octagon ms-alert-icon"></i>
                <div class="ms-alert-content">
                    <div class="ms-alert-title">Perhatian</div>
                    <div>@Message</div>
                </div>
                <button type="button" class="ms-alert-close" @onclick="() => Message = null">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }

        <div class="row g-4">
            <!-- Left Column: Parameters & Slots -->
            <div class="col-lg-5">
                <div class="ms-card p-3.5 h-100" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                        <span class="d-inline-flex align-items-center justify-content-center fw-bold font-mono" 
                              style="width: 24px; height: 24px; font-size: 0.75rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-xs); color: var(--ms-primary);">
                            01
                        </span>
                        <h6 class="fw-bold text-white mb-0" style="font-size: 0.95rem;">Tentukan Tanggal & Tamu</h6>
                    </div>

                    <!-- Date picker -->
                    <div class="ms-form-group">
                        <label class="ms-form-label" for="bookingDate">
                            <i class="bi bi-calendar3 me-1 text-primary"></i> Tanggal Kunjungan <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="ms-form-control font-mono" id="bookingDate" @value="BookingDate" 
                               @onchange="OnDateChanged" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <!-- Guest Stepper -->
                    <div class="ms-form-group">
                        <label class="ms-form-label">
                            <i class="bi bi-people me-1 text-primary"></i> Jumlah Tamu <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="ms-btn ms-btn-secondary px-3" @onclick="DecrementGuests">-</button>
                            <input type="number" class="ms-form-control text-center font-mono fw-bold text-primary" 
                                   @value="GuestCount" @onchange="OnGuestsChanged" min="1" max="20" style="max-width: 90px;" />
                            <button type="button" class="ms-btn ms-btn-secondary px-3" @onclick="IncrementGuests">+</button>
                            <span class="small font-mono ms-2" style="color: var(--ms-text-dim);">Orang</span>
                        </div>
                    </div>

                    <!-- Time Slots Selector -->
                    <div class="mt-4 pt-3" style="border-top: 1px solid var(--ms-border);">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="fw-bold text-white" style="font-size: 0.85rem;">
                                <i class="bi bi-clock me-1 text-primary"></i> Slot Waktu Tersedia: <span class="text-danger">*</span>
                            </span>
                            <span class="ms-badge ms-badge-neutral">@Slots.Count Slot</span>
                        </div>

                        @if (Slots == null || !Slots.Any())
                        {
                            <div class="text-center py-4 small" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-sm); color: var(--ms-text-dim);">
                                <span>Tidak ada slot waktu tersedia atau restoran belum dimuat.</span>
                            </div>
                        }
                        else
                        {
                            <div class="row g-2">
                                @foreach (var slot in Slots)
                                {
                                    var isSelected = SelectedStartTime == slot.StartTime;
                                    var isSlotDisabled = !slot.IsAvailable;
                                    
                                    <div class="col-6">
                                        <div class="ms-slot-card @(isSelected ? "selected" : "") @(isSlotDisabled ? "disabled" : "")"
                                             @onclick="() => SelectSlot(slot)">
                                            <div class="fw-bold font-mono text-white fs-6">@slot.StartTime</div>
                                            <div class="small font-mono mb-1" style="font-size: 0.72rem; color: var(--ms-text-dim);">s/d @slot.EndTime WIB</div>
                                            @if (slot.IsAvailable)
                                            {
                                                <span class="ms-badge ms-badge-success" style="font-size: 0.68rem;">
                                                    <span class="ms-badge-dot"></span> @slot.AvailableTablesCount Meja
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="ms-badge ms-badge-danger" style="font-size: 0.68rem;">
                                                    Penuh
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Guest Information & Confirmation -->
            <div class="col-lg-7">
                <div class="ms-card p-3.5 h-100" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                        <span class="d-inline-flex align-items-center justify-content-center fw-bold font-mono" 
                              style="width: 24px; height: 24px; font-size: 0.75rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-xs); color: var(--ms-primary);">
                            02
                        </span>
                        <h6 class="fw-bold text-white mb-0" style="font-size: 0.95rem;">Informasi Kontak Pemesan</h6>
                    </div>

                    @if (string.IsNullOrEmpty(SelectedStartTime))
                    {
                        <div class="ms-alert ms-alert-warning mb-3">
                            <i class="bi bi-info-circle ms-alert-icon"></i>
                            <div class="ms-alert-content">
                                <div class="ms-alert-title">Pilih Slot Waktu</div>
                                <div class="small">Silakan pilih salah satu slot waktu yang tersedia pada panel di sebelah kiri.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-2.5 mb-3 d-flex align-items-center justify-content-between font-mono" 
                             style="background-color: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                            <div>
                                <span class="small d-block" style="font-size: 0.7rem; color: var(--ms-text-dim);">SLOT TERPILIH:</span>
                                <strong class="text-primary fs-6">
                                    <i class="bi bi-clock me-1"></i> @SelectedStartTime - @SelectedEndTime WIB
                                </strong>
                            </div>
                            <span class="ms-badge ms-badge-primary">
                                <i class="bi bi-people me-1"></i> @GuestCount Orang
                            </span>
                        </div>
                    }

                    <form @onsubmit="SubmitBooking">
                        <div class="ms-form-group">
                            <label class="ms-form-label" for="guestName">
                                <i class="bi bi-person me-1 text-primary"></i> Nama Lengkap Pemesan <span class="text-danger">*</span>
                            </label>
                            <input type="text" class="ms-form-control @(string.IsNullOrWhiteSpace(BookingName) && HasAttemptedSubmit ? "is-invalid" : "")" 
                                   id="guestName" name="name" autocomplete="name" @bind="BookingName" required placeholder="Nama Lengkap Anda" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="ms-form-group">
                                    <label class="ms-form-label" for="guestEmail">
                                        <i class="bi bi-envelope me-1 text-primary"></i> Alamat Email <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" class="ms-form-control @(string.IsNullOrWhiteSpace(BookingEmail) && HasAttemptedSubmit ? "is-invalid" : "")" 
                                           id="guestEmail" name="email" autocomplete="email" @bind="BookingEmail" required placeholder="alamat@email.com" />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="ms-form-group">
                                    <label class="ms-form-label" for="guestPhone">
                                        <i class="bi bi-telephone me-1 text-primary"></i> No. WhatsApp / Telepon <span class="text-danger">*</span>
                                    </label>
                                    <input type="tel" class="ms-form-control font-mono @(string.IsNullOrWhiteSpace(BookingPhone) && HasAttemptedSubmit ? "is-invalid" : "")" 
                                           id="guestPhone" name="tel" autocomplete="tel" @bind="BookingPhone" required placeholder="08xxxxxxxxxx" />
                                </div>
                            </div>
                        </div>

                        <div class="ms-form-group">
                            <label class="ms-form-label" for="guestNotes">
                                <i class="bi bi-chat-text me-1 text-primary"></i> Catatan Khusus (Opsional)
                            </label>
                            <textarea class="ms-form-control" id="guestNotes" @bind="BookingNotes" rows="3" placeholder="Permintaan khusus: area dekat jendela, kursi bayi, acara keluarga, dll."></textarea>
                        </div>

                        <div class="pt-3 mt-3" style="border-top: 1px solid var(--ms-border);">
                            <button type="submit" class="ms-btn ms-btn-primary w-100" 
                                    disabled="@IsSubmitting">
                                @if (IsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Memproses Reservasi Anda...</span>
                                }
                                else
                                {
                                    <span>Konfirmasi & Buat Reservasi</span>
                                    <i class="bi bi-arrow-right ms-1"></i>
                                }
                            </button>
                            <div class="font-mono text-center mt-2" style="font-size: 0.7rem; color: var(--ms-text-dim);">
                                Terenkripsi & terhubung langsung dengan sistem reservasi outlet.
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string TenantCode = "";
    private bool IsLoading = false;
    private bool IsSubmitting = false;
    private bool HasAttemptedSubmit = false;
    private string? Message;

    private Tenant? ActiveTenant;
    private List<Table> Tables = new List<Table>();
    private List<Reservation> ExistingReservations = new List<Reservation>();

    private string BookingName = "";
    private string BookingEmail = "";
    private string BookingPhone = "";
    private DateTime BookingDate = DateTime.Today.AddDays(1);
    private int GuestCount = 2;
    private string SelectedStartTime = "";
    private string SelectedEndTime = "";
    private string BookingNotes = "";

    private List<TimeSlotInfo> Slots = new List<TimeSlotInfo>();
    private bool ShowSuccessCard = false;
    private Reservation? ConfirmedReservation;

    public class BrandingConfig
    {
        public string PrimaryColor { get; set; } = "#6366F1";
        public string SecondaryColor { get; set; } = "#4F46E5";
        public string Font { get; set; } = "Plus Jakarta Sans";
    }

    public class TimeSlotsConfig
    {
        public int SlotDuration { get; set; } = 60;
        public int MaxConcurrentCovers { get; set; } = 30;
        public string OpeningTime { get; set; } = "08:00";
        public string ClosingTime { get; set; } = "22:00";
    }

    public class TimeSlotInfo
    {
        public string StartTime { get; set; } = "";
        public string EndTime { get; set; } = "";
        public bool IsAvailable { get; set; }
        public int AvailableTablesCount { get; set; }
    }

    private BrandingConfig Branding = new BrandingConfig();
    private TimeSlotsConfig TimeSlots = new TimeSlotsConfig();

    private HttpClient GetClient()
    {
        var client = ClientFactory.CreateClient("TenantApi");
        client.DefaultRequestHeaders.Clear();
        if (!string.IsNullOrWhiteSpace(TenantCode))
        {
            client.DefaultRequestHeaders.Add("x-tenant-code", TenantCode.Trim().ToUpperInvariant());
        }
        return client;
    }

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("tenant", out var code))
        {
            TenantCode = code.ToString().ToUpperInvariant();
            await LoadTenantBranding();
        }
    }

    private async Task LoadTenantBranding()
    {
        if (string.IsNullOrWhiteSpace(TenantCode))
        {
            Message = "Harap masukkan kode restoran terlebih dahulu.";
            return;
        }

        IsLoading = true;
        Message = null;
        ActiveTenant = null;
        Tables.Clear();
        ExistingReservations.Clear();
        SelectedStartTime = "";

        try
        {
            var client = GetClient();
            var response = await client.GetAsync("/api/v1/branding");
            if (response.IsSuccessStatusCode)
            {
                var doc = await response.Content.ReadFromJsonAsync<JsonElement>();
                var data = doc.GetProperty("data");
                ActiveTenant = JsonSerializer.Deserialize<Tenant>(data.GetProperty("tenant").GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                Branding = JsonSerializer.Deserialize<BrandingConfig>(data.GetProperty("branding").GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new BrandingConfig();
                TimeSlots = JsonSerializer.Deserialize<TimeSlotsConfig>(data.GetProperty("timeSlots").GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new TimeSlotsConfig();

                await LoadTablesAndReservations();
                ComputeTimeSlots();
            }
            else
            {
                Message = $"Restoran dengan kode '{TenantCode}' tidak ditemukan atau belum aktif.";
            }
        }
        catch (Exception ex)
        {
            Message = $"Gagal memuat data restoran: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadTablesAndReservations()
    {
        try
        {
            var client = GetClient();
            var resTables = await client.GetAsync("/api/v1/tables");
            if (resTables.IsSuccessStatusCode)
            {
                var doc = await resTables.Content.ReadFromJsonAsync<JsonElement>();
                var array = doc.GetProperty("data");
                Tables = JsonSerializer.Deserialize<List<Table>>(array.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<Table>();
            }

            var dateStr = BookingDate.ToString("yyyy-MM-dd");
            var resReservations = await client.GetAsync($"/api/v1/reservations?date={dateStr}");
            if (resReservations.IsSuccessStatusCode)
            {
                var doc = await resReservations.Content.ReadFromJsonAsync<JsonElement>();
                var array = doc.GetProperty("data");
                ExistingReservations = JsonSerializer.Deserialize<List<Reservation>>(array.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<Reservation>();
            }
        }
        catch { }
    }

    private void ComputeTimeSlots()
    {
        Slots.Clear();
        if (!TimeSpan.TryParse(TimeSlots.OpeningTime, out var openTime)) openTime = new TimeSpan(8, 0, 0);
        if (!TimeSpan.TryParse(TimeSlots.ClosingTime, out var closeTime)) closeTime = new TimeSpan(22, 0, 0);
        var duration = TimeSpan.FromMinutes(TimeSlots.SlotDuration > 0 ? TimeSlots.SlotDuration : 60);

        var current = openTime;
        var nowTime = DateTime.Now.TimeOfDay;
        var isToday = BookingDate.Date == DateTime.Today;

        while (current + duration <= closeTime)
        {
            var start = current;
            var end = current + duration;
            var startStr = start.ToString(@"hh\:mm");
            var endStr = end.ToString(@"hh\:mm");

            bool isPastTime = isToday && (start <= nowTime);

            var overlapping = ExistingReservations
                .Where(r => r.Status != "CANCELLED" && r.Status != "EXPIRED")
                .Where(r => (r.StartTime < end && r.EndTime > start))
                .ToList();

            var bookedTableIds = overlapping.Select(r => r.TableId).ToHashSet();
            var suitableTables = Tables
                .Where(t => t.IsActive && t.Capacity >= GuestCount && !bookedTableIds.Contains(t.TableId))
                .ToList();

            var totalGuestsInSlot = overlapping.Sum(r => r.GuestCount);
            var maxCap = TimeSlots.MaxConcurrentCovers > 0 ? TimeSlots.MaxConcurrentCovers : 50;
            var capacityReached = (totalGuestsInSlot + GuestCount) > maxCap;

            var available = !isPastTime && suitableTables.Any() && !capacityReached;

            Slots.Add(new TimeSlotInfo
            {
                StartTime = startStr,
                EndTime = endStr,
                IsAvailable = available,
                AvailableTablesCount = suitableTables.Count
            });

            current += duration;
        }
    }

    private void SelectSlot(TimeSlotInfo slot)
    {
        if (!slot.IsAvailable) return;
        SelectedStartTime = slot.StartTime;
        SelectedEndTime = slot.EndTime;
    }

    private void IncrementGuests()
    {
        if (GuestCount < 20)
        {
            GuestCount++;
            ComputeTimeSlots();
        }
    }

    private void DecrementGuests()
    {
        if (GuestCount > 1)
        {
            GuestCount--;
            ComputeTimeSlots();
        }
    }

    private void OnGuestsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var g))
        {
            GuestCount = Math.Clamp(g, 1, 20);
            ComputeTimeSlots();
        }
    }

    private async Task OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            BookingDate = d;
            await LoadTablesAndReservations();
            ComputeTimeSlots();
        }
    }

    private async Task SubmitBooking()
    {
        HasAttemptedSubmit = true;
        Message = null;

        if (string.IsNullOrWhiteSpace(TenantCode) || ActiveTenant == null)
        {
            Message = "Pilih restoran terlebih dahulu.";
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedStartTime))
        {
            Message = "Silakan pilih salah satu slot waktu yang tersedia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(BookingName) || string.IsNullOrWhiteSpace(BookingEmail) || string.IsNullOrWhiteSpace(BookingPhone))
        {
            Message = "Harap lengkapi nama, email, dan nomor telepon pemesan.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var payload = new
            {
                guestName = BookingName.Trim(),
                guestEmail = BookingEmail.Trim(),
                guestPhone = BookingPhone.Trim(),
                date = BookingDate.ToString("yyyy-MM-dd"),
                startTime = SelectedStartTime,
                endTime = SelectedEndTime,
                guestCount = GuestCount,
                notes = BookingNotes.Trim()
            };

            var response = await client.PostAsJsonAsync("/api/v1/reservations", payload);
            if (response.IsSuccessStatusCode)
            {
                var doc = await response.Content.ReadFromJsonAsync<JsonElement>();
                var data = doc.GetProperty("data");
                ConfirmedReservation = JsonSerializer.Deserialize<Reservation>(data.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                ShowSuccessCard = true;
            }
            else
            {
                var errDoc = await response.Content.ReadAsStringAsync();
                Message = $"Gagal membuat reservasi: {errDoc}";
            }
        }
        catch (Exception ex)
        {
            Message = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void ResetForm()
    {
        ShowSuccessCard = false;
        ConfirmedReservation = null;
        SelectedStartTime = "";
        SelectedEndTime = "";
        BookingNotes = "";
        HasAttemptedSubmit = false;
        ComputeTimeSlots();
    }
}
