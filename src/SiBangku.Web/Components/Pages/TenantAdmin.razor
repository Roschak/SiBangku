                                            <div class="d-flex gap-2 align-items-center">
                                                <input type="color" class="form-control form-control-color border-0 p-1" @bind="Branding.SecondaryColor" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-xs);" />
                                                <input type="text" class="ms-form-control font-mono" @bind="Branding.SecondaryColor" placeholder="#A07E3F" />
                                            </div>
                                            <small class="text-muted font-mono" style="font-size: 0.7rem;">Hover state, badge, highlight</small>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="ms-form-label">Background Color (Latar Belakang)</label>
                                            <input type="text" class="ms-form-control font-mono" @bind="BrandingBackgroundColor" placeholder="#FAF8F5" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="ms-form-label">Text Color (Warna Teks)</label>
                                            <input type="text" class="ms-form-control font-mono" @bind="BrandingTextColor" placeholder="#1C1714" />
                                        </div>

