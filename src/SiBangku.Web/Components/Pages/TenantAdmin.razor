                                                <option value="Lato">Lato (Professional)</option>
                                                <option value="Roboto">Roboto (Tech-Forward)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <h6 class="fw-bold mb-3" style="font-size: 0.85rem; color: var(--ms-text-main);">
                                        <i class="bi bi-image text-primary me-1"></i> Aset Visual (Logo, Favicon, Banner):
                                    </h6>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <label class="ms-form-label">URL Logo Restoran (PNG/JPG)</label>
                                            <input type="text" class="ms-form-control font-mono" @bind="BrandingLogoUrl" placeholder="https://.../logo.png" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="ms-form-label">URL Favicon Browser (ICO/PNG)</label>
                                            <input type="text" class="ms-form-control font-mono" @bind="BrandingFaviconUrl" placeholder="https://.../favicon.png" />
                                        </div>
                                        <div class="col-12">
                                            <label class="ms-form-label">URL Banner Restoran (Hero Background)</label>
                                            <input type="text" class="ms-form-control font-mono" @bind="BrandingBannerUrl" placeholder="https://.../banner.jpg" />
                                        </div>
                                    </div>

                                    <button type="submit" class="ms-btn ms-btn-primary w-100" disabled="@IsSubmitting">
                                        <i class="bi bi-check2 me-1"></i> Simpan Kustomisasi Branding
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Right: Live Theme Preview Card -->
                        <div class="col-lg-5">
                            <div class="ms-card p-4">
                                <h6 class="ms-card-title mb-3">Pratinjau Tema Real-Time</h6>
                                <div class="p-3 rounded border" style="background: @BrandingBackgroundColor; color: @BrandingTextColor; border-color: @Branding.PrimaryColor !important;">
                                    <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                        <strong style="color: @Branding.PrimaryColor;">@(ActiveTenant?.RestaurantName ?? "Restoran Contoh")</strong>
                                        <span class="badge" style="background: @Branding.SecondaryColor; color: #fff;">LIVE PREVIEW</span>
                                    </div>
                                    <p class="small mb-3" style="font-family: @Branding.Font;">
                                        Ini adalah pratinjau tampilan kartu dan tombol booking pada portal tamu dan aplikasi APK Android.
                                    </p>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm font-mono fw-bold" style="background: @Branding.PrimaryColor; color: #1A1206;">
