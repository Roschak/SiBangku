                                <div class="d-flex align-items-center gap-2 mb-4 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                                    <i class="bi bi-palette text-primary fs-5"></i>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.95rem; color: var(--ms-text-main);">Branding Customization (Warna & Aset)</h6>
                                </div>

