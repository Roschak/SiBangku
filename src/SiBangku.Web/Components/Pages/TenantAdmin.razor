@page "/admin"
@page "/tenant-admin"
@layout Layout.PortalLayout
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Text.Json
@using SiBangku.Shared.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Portal Admin Restoran - SiBangku Management System</PageTitle>

@if (!IsLoggedIn)
{
    <!-- Login Screen for Restaurant Client -->
    <div class="min-vh-100 d-flex flex-column justify-content-center py-5" style="background-color: var(--ms-surface-dark);">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5 col-xl-4">
                    <div class="text-center mb-4">
                        <a href="/" class="d-inline-flex align-items-center gap-2 text-decoration-none mb-2">
                            <span class="d-inline-flex align-items-center justify-content-center" 
                                  style="width: 36px; height: 36px; font-size: 1.1rem; background: rgba(212, 175, 55, 0.10); border: 1px solid rgba(212, 175, 55, 0.35); border-radius: var(--ms-radius-sm); color: #D4AF37;">
                                <i class="bi bi-shop"></i>
                            </span>
                            <span class="fs-5 fw-bold tracking-tight ms-serif" style="color: var(--ms-text-main, #1C1714);">SiBangku Resto</span>
                        </a>
                        <div class="font-mono text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;">Outlet Management & Reservations</div>
                    </div>

                    <div class="ms-card p-4 p-md-4.5" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
                        @if (!string.IsNullOrEmpty(LoginError))
                        {
                            <div class="ms-alert ms-alert-danger mb-3">
                                <i class="bi bi-exclamation-octagon-fill ms-alert-icon"></i>
                                <div class="ms-alert-content">
                                    <div class="ms-alert-title">Autentikasi Gagal</div>
                                    <div>@LoginError</div>
                                </div>
                                <button type="button" class="ms-alert-close" @onclick="() => LoginError = null">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }

                        <form @onsubmit="HandleLogin">
                            <div class="ms-form-group">
                                <label class="ms-form-label" for="tenantCode">
                                    <i class="bi bi-tag me-1 text-primary"></i> Kode Outlet Restoran <span class="text-danger">*</span>
                                </label>
                                <div class="ms-input-group">
                                    <i class="bi bi-shop ms-input-icon"></i>
                                    <input type="text" class="ms-form-control has-icon-left font-mono fw-bold text-uppercase @(HasAttemptedLogin && string.IsNullOrWhiteSpace(TenantCode) ? "is-invalid" : "")" 
                                           id="tenantCode" name="tenantCode" autocomplete="organization" @bind="TenantCode" @bind:event="oninput" placeholder="KODE RESTORAN (e.g. GRAND-BISTRO)" />
                                </div>
                            </div>

                            <div class="ms-form-group">
                                <label class="ms-form-label" for="loginEmail">
                                    <i class="bi bi-envelope me-1 text-primary"></i> Email Administrator <span class="text-danger">*</span>
                                </label>
                                <div class="ms-input-group">
                                    <i class="bi bi-person ms-input-icon"></i>
                                    <input type="email" class="ms-form-control has-icon-left @(HasAttemptedLogin && string.IsNullOrWhiteSpace(Email) ? "is-invalid" : "")" 
                                           id="loginEmail" name="username" autocomplete="username" @bind="Email" @bind:event="oninput" placeholder="admin@outlet.com" />
                                </div>
                            </div>

                            <div class="ms-form-group mb-4">
                                <label class="ms-form-label" for="loginPassword">
                                    <i class="bi bi-key me-1 text-primary"></i> Kata Sandi <span class="text-danger">*</span>
                                </label>
                                <div class="ms-input-group">
                                    <i class="bi bi-lock ms-input-icon"></i>
                                    <input type="password" class="ms-form-control has-icon-left @(HasAttemptedLogin && string.IsNullOrWhiteSpace(Password) ? "is-invalid" : "")" 
                                           id="loginPassword" name="password" autocomplete="current-password" @bind="Password" @bind:event="oninput" placeholder="Masukkan kata sandi" />
                                </div>
                            </div>

                            <button type="submit" class="ms-btn ms-btn-primary w-100" disabled="@IsSubmitting">
                                @if (IsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Memverifikasi...</span>
                                }
                                else
                                {
                                    <span>Masuk ke Dashboard Resto</span>
                                    <i class="bi bi-arrow-right ms-1"></i>
                                }
                            </button>
                        </form>

                        <div class="mt-4 pt-3 text-center" style="border-top: 1px solid var(--ms-border);">
                            <a href="/" class="small text-decoration-none" style="color: var(--ms-text-muted);">
                                <i class="bi bi-arrow-left me-1"></i> Kembali ke Beranda Publik
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Restaurant Management System Portal Layout -->
    <div class="ms-admin-wrapper" style="--ms-primary: @Branding.PrimaryColor; --ms-primary-hover: @Branding.SecondaryColor;">
        <!-- Left Sidebar -->
        <aside class="ms-sidebar">
            <div class="ms-sidebar-brand">
                <div class="ms-sidebar-brand-icon">
                    <i class="bi bi-shop text-primary"></i>
                </div>
                <div class="overflow-hidden">
                    <h6 class="ms-sidebar-brand-title text-truncate">@(ActiveTenant?.RestaurantName ?? "Resto Admin")</h6>
                    <span class="ms-sidebar-brand-subtitle font-mono">@TenantCode</span>
                </div>
            </div>

            <div class="ms-sidebar-nav">
                <!-- 1. Operasional Harian -->
                <div class="ms-sidebar-section-title">Operasional</div>
                
                <button class="ms-sidebar-item @(ActiveTab == "overview" ? "active" : "")" @onclick='() => SwitchTab("overview")'>
                    <i class="bi bi-grid-1x2"></i>
                    <span>Ringkasan & Metrik</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "reservations" ? "active" : "")" @onclick='() => SwitchTab("reservations")'>
                    <i class="bi bi-calendar-check"></i>
                    <span>Kelola Reservasi</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "tables" ? "active" : "")" @onclick='() => SwitchTab("tables")'>
                    <i class="bi bi-layout-wtf"></i>
                    <span>Katalog & Denah Meja</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "menu" ? "active" : "")" @onclick='() => SwitchTab("menu")'>
                    <i class="bi bi-journal-text"></i>
                    <span>Manajemen Menu</span>
                </button>

                <!-- 2. Kustomisasi & Outlet -->
                <div class="ms-sidebar-section-title">Kustomisasi Outlet</div>

                <button class="ms-sidebar-item @(ActiveTab == "branding" ? "active" : "")" @onclick='() => SwitchTab("branding")'>
                    <i class="bi bi-palette"></i>
                    <span>Branding & Visual</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "operational" ? "active" : "")" @onclick='() => SwitchTab("operational")'>
                    <i class="bi bi-clock"></i>
                    <span>Jam Operasional & Slot</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "staff" ? "active" : "")" @onclick='() => SwitchTab("staff")'>
                    <i class="bi bi-people"></i>
                    <span>Manajemen Staff</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "payment" ? "active" : "")" @onclick='() => SwitchTab("payment")'>
                    <i class="bi bi-credit-card"></i>
                    <span>Metode Pembayaran</span>
                </button>

                <!-- 3. Distribusi & Laporan -->
                <div class="ms-sidebar-section-title">Distribusi & Laporan</div>

                <button class="ms-sidebar-item @(ActiveTab == "reports" ? "active" : "")" @onclick='() => SwitchTab("reports")'>
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Laporan & Analitik</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "apk" ? "active" : "")" @onclick='() => SwitchTab("apk")'>
                    <i class="bi bi-phone"></i>
                    <span>Sinkronisasi APK</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "qrcode" ? "active" : "")" @onclick='() => SwitchTab("qrcode")'>
                    <i class="bi bi-qr-code-scan"></i>
                    <span>Standee QR Cetak</span>
                </button>
            </div>

            <div class="ms-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="d-flex align-items-center justify-content-center fw-bold font-mono" 
                             style="width: 28px; height: 28px; font-size: 0.75rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-xs); color: var(--ms-primary);">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="small fw-bold text-truncate" style="color: var(--ms-text-main);">@Email</div>
                            <div class="font-mono text-truncate" style="font-size: 0.68rem; color: var(--ms-text-dim);">Admin Mitra</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <a href="/" class="ms-btn ms-btn-secondary ms-btn-sm w-100" title="Ke Beranda Tamu">
                        <i class="bi bi-house"></i>
                    </a>
                    <button class="ms-btn ms-btn-danger ms-btn-sm w-100" @onclick="HandleLogout" title="Logout">
                        <i class="bi bi-box-arrow-right"></i> Keluar
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="ms-admin-main">
            <!-- Topbar -->
            <header class="ms-admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <h6 class="fw-bold mb-0" style="font-size: 0.95rem; color: var(--ms-text-main);">
                        @if (ActiveTab == "overview") { <span>Ringkasan Operasional Restoran</span> }
                        else if (ActiveTab == "reservations") { <span>Daftar Reservasi Meja</span> }
                        else if (ActiveTab == "tables") { <span>Katalog & Denah Meja Interaktif</span> }
                        else if (ActiveTab == "menu") { <span>Katalog & Manajemen Menu</span> }
                        else if (ActiveTab == "branding") { <span>Kustomisasi Tema Visual & Branding</span> }
                        else if (ActiveTab == "operational") { <span>Pengaturan Jam Operasional & Alokasi Slot</span> }
                        else if (ActiveTab == "staff") { <span>Manajemen Akun & Hak Akses Staff</span> }
                        else if (ActiveTab == "payment") { <span>Konfigurasi QRIS & Metode Pembayaran</span> }
                        else if (ActiveTab == "reports") { <span>Laporan & Analitik Reservasi</span> }
                        else if (ActiveTab == "apk") { <span>Sinkronisasi Otomatis Aplikasi APK</span> }
                        else if (ActiveTab == "qrcode") { <span>Generator Standee & QR Code Cetak</span> }
                    </h6>
                    <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> Outlet Online</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="RefreshAllData">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                    <a href="/booking?tenant=@TenantCode" target="_blank" class="ms-btn ms-btn-primary ms-btn-sm">
                        <i class="bi bi-arrow-up-right"></i> Buka Portal Booking
                    </a>
                </div>
            </header>

            <!-- Body Content Area -->
            <div class="ms-admin-content">
                <!-- Action Alerts -->
                @if (!string.IsNullOrEmpty(SuccessAlert))
                {
                    <div class="ms-alert ms-alert-success mb-4 shadow-sm">
                        <i class="bi bi-check-circle-fill ms-alert-icon"></i>
                        <div class="ms-alert-content">
                            <div class="ms-alert-title">Berhasil</div>
                            <div>@SuccessAlert</div>
                        </div>
                        <button type="button" class="ms-alert-close" @onclick="() => SuccessAlert = null">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ErrorAlert))
                {
                    <div class="ms-alert ms-alert-danger mb-4 shadow-sm">
                        <i class="bi bi-exclamation-octagon-fill ms-alert-icon"></i>
                        <div class="ms-alert-content">
                            <div class="ms-alert-title">Perhatian</div>
                            <div>@ErrorAlert</div>
                        </div>
                        <button type="button" class="ms-alert-close" @onclick="() => ErrorAlert = null">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }

                <!-- Trial-Expired Conditional Alert Banner (Only shown if trial is expired, hidden during active trial) -->
                @if (ActiveTenant != null && (ActiveTenant.Status == "TRIAL_EXPIRED" || (ActiveTenant.TrialEnd != null && ActiveTenant.TrialEnd.Value < DateTime.UtcNow)))
                {
                    <div class="ms-card p-3 mb-4" style="border: 1px solid rgba(220, 38, 38, 0.35); background: rgba(220, 38, 38, 0.04); border-left: 4px solid var(--ms-danger);">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                                <div>
                                    <strong class="text-danger">Masa Uji Coba (Trial) Outlet Telah Berakhir</strong>
                                    <div class="small text-muted font-mono" style="font-size: 0.74rem;">
                                        Masa trial selesai pada @(ActiveTenant.TrialEnd?.ToString("yyyy-MM-dd") ?? "-"). Silakan hubungi Super Admin untuk perpanjangan lisensi.
                                    </div>
                                </div>
                            </div>
                            <span class="ms-badge ms-badge-danger font-mono"><i class="bi bi-lock-fill me-1"></i> TRIAL EXPIRED</span>
                        </div>
                    </div>
                }

                <!-- ========================================================================= -->
                <!-- 1. OVERVIEW / RINGKASAN -->
                <!-- ========================================================================= -->
                @if (ActiveTab == "overview")
                {
                    <!-- Stat Cards Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Total Pemesanan</span>
                                    <div class="ms-stat-icon">
                                        <i class="bi bi-calendar2-range"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value">@ReservationsList.Count</div>
                                <p class="ms-stat-hint">Seluruh jadwal reservasi</p>
                            </div>
                        </div>

                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Menunggu Konfirmasi</span>
                                    <div class="ms-stat-icon text-warning">
                                        <i class="bi bi-hourglass-split"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value text-warning">@ReservationsList.Count(r => r.Status == "PENDING")</div>
                                <p class="ms-stat-hint">Perlu tindakan verifikasi staff</p>
                            </div>
                        </div>

                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Terkonfirmasi</span>
                                    <div class="ms-stat-icon text-success">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value text-success">@ReservationsList.Count(r => r.Status == "CONFIRMED")</div>
                                <p class="ms-stat-hint">Siap menyambut kedatangan tamu</p>
                            </div>
                        </div>

                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Batal / Timeout</span>
                                    <div class="ms-stat-icon text-danger">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value text-danger">@ReservationsList.Count(r => r.Status == "CANCELLED" || r.Status == "EXPIRED")</div>
                                <p class="ms-stat-hint">Dibatalkan atau timeout pembayaran</p>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Overview Row -->
                    <div class="row g-4 mb-4">
                        <div class="col-lg-8">
                            <div class="ms-card p-4">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <h6 class="ms-card-title mb-0">Tindakan Cepat Hari Ini</h6>
                                    <span class="font-mono small text-muted">@DateTime.Today.ToString("dd MMMM yyyy")</span>
                                </div>
                                <div class="row g-3">
                                    <div class="col-sm-4">
                                        <div class="p-3 rounded border text-center" style="background: var(--ms-surface-elevated); border-color: var(--ms-border) !important;">
                                            <i class="bi bi-people fs-3 text-primary d-block mb-1"></i>
                                            <div class="font-mono fw-bold fs-5" style="color: var(--ms-text-main);">@ReservationsList.Where(r => r.Status == "CONFIRMED").Sum(r => r.GuestCount)</div>
                                            <div class="small text-muted font-mono" style="font-size: 0.72rem;">Estimasi Tamu Hadir</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="p-3 rounded border text-center" style="background: var(--ms-surface-elevated); border-color: var(--ms-border) !important;">
                                            <i class="bi bi-cash-coin fs-3 text-success d-block mb-1"></i>
                                            <div class="font-mono fw-bold fs-5 text-success">Rp 1.850.000</div>
                                            <div class="small text-muted font-mono" style="font-size: 0.72rem;">Estimasi Omzet Reservasi</div>
                                        </div>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="p-3 rounded border text-center" style="background: var(--ms-surface-elevated); border-color: var(--ms-border) !important;">
                                            <i class="bi bi-grid-3x3 fs-3 text-warning d-block mb-1"></i>
                                            <div class="font-mono fw-bold fs-5 text-warning">@TablesList.Count Meja</div>
                                            <div class="small text-muted font-mono" style="font-size: 0.72rem;">Kapasitas Siap Operasional</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <div class="ms-card p-4 h-100">
                                <h6 class="ms-card-title mb-3">Pintasan Manajemen</h6>
                                <div class="d-flex flex-column gap-2">
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm text-start" @onclick='() => SwitchTab("reservations")'>
                                        <i class="bi bi-calendar-check me-2 text-primary"></i> Periksa Jadwal Reservasi
                                    </button>
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm text-start" @onclick='() => SwitchTab("tables")'>
                                        <i class="bi bi-layout-wtf me-2 text-primary"></i> Atur Denah Meja Restoran
                                    </button>
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm text-start" @onclick='() => SwitchTab("menu")'>
                                        <i class="bi bi-journal-plus me-2 text-primary"></i> Kelola Item Menu Santapan
                                    </button>
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm text-start" @onclick='() => SwitchTab("apk")'>
                                        <i class="bi bi-arrow-repeat me-2 text-primary"></i> Sinkronisasi ke APK Android
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================================= -->
                <!-- 2. KELOLA RESERVASI -->
                <!-- ========================================================================= -->
                @if (ActiveTab == "reservations" || ActiveTab == "overview")
                {
                    <div class="ms-card">
                        <div class="ms-card-header flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-table text-primary"></i>
                                <h6 class="ms-card-title">Jadwal Reservasi Pelanggan</h6>
                            </div>
                            
                            <!-- Search & Filter Controls -->
                            <div class="d-flex align-items-center gap-2">
                                <div class="ms-input-group">
                                    <i class="bi bi-search ms-input-icon"></i>
                                    <input type="text" class="ms-form-control ms-form-control-sm has-icon-left font-mono" 
                                           @bind="SearchReservationQuery" @bind:event="oninput" 
                                           placeholder="Cari kode / tamu..." style="max-width: 220px; font-size: 0.8rem;" />
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="ms-table">
                                <thead>
                                    <tr>
                                        <th>Kode Booking</th>
                                        <th>Catatan & Tamu</th>
                                        <th>Jadwal Reservasi</th>
                                        <th>Status Bayar</th>
                                        <th>Status Reservasi</th>
                                        <th class="text-end">Tindakan Staff</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var filtered = ReservationsList
                                            .Where(r => string.IsNullOrEmpty(SearchReservationQuery) || 
                                                        r.ReservationNumber.Contains(SearchReservationQuery, StringComparison.OrdinalIgnoreCase) ||
                                                        r.Notes.Contains(SearchReservationQuery, StringComparison.OrdinalIgnoreCase))
                                            .ToList();
                                    }

                                    @if (!filtered.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5" style="color: var(--ms-text-dim);">
                                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                                <span>Belum ada reservasi tercatat untuk filter ini.</span>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var rsv in filtered)
                                        {
                                            <tr>
                                                <td>
                                                    <strong class="text-primary font-mono fs-6">@rsv.ReservationNumber</strong>
                                                    <small class="d-block font-mono" style="font-size: 0.7rem; color: var(--ms-text-dim);">@rsv.Id</small>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold" style="color: var(--ms-text-main);"><i class="bi bi-people me-1 text-primary"></i> @rsv.GuestCount Orang</div>
                                                    <small class="text-truncate d-block" style="max-width: 200px; color: var(--ms-text-dim);">
                                                        @(string.IsNullOrEmpty(rsv.Notes) ? "Tanpa catatan" : rsv.Notes)
                                                    </small>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold font-mono" style="color: var(--ms-text-main);"><i class="bi bi-calendar3 me-1 text-primary"></i> @rsv.Date.ToString("yyyy-MM-dd")</div>
                                                    <small class="font-mono" style="color: var(--ms-text-dim);"><i class="bi bi-clock me-1"></i> @rsv.StartTime.ToString(@"hh\:mm") - @rsv.EndTime.ToString(@"hh\:mm") WIB</small>
                                                </td>
                                                <td>
                                                    @if (rsv.PaymentStatus == "PAID")
                                                    {
                                                        <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> LUNAS</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ms-badge ms-badge-warning"><span class="ms-badge-dot"></span> BELUM BAYAR</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (rsv.Status == "CONFIRMED")
                                                    {
                                                        <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> CONFIRMED</span>
                                                    }
                                                    else if (rsv.Status == "PENDING")
                                                    {
                                                        <span class="ms-badge ms-badge-warning"><span class="ms-badge-dot"></span> PENDING</span>
                                                    }
                                                    else if (rsv.Status == "CANCELLED" || rsv.Status == "EXPIRED")
                                                    {
                                                        <span class="ms-badge ms-badge-danger">@rsv.Status</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ms-badge ms-badge-neutral">@rsv.Status</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex gap-1.5">
                                                        @if (rsv.PaymentStatus != "PAID")
                                                        {
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-success font-mono" title="Tandai Lunas" @onclick='() => UpdatePayment(rsv, "PAID")'>
                                                                <i class="bi bi-cash-stack"></i> Lunas
                                                            </button>
                                                        }
                                                        @if (rsv.Status == "PENDING")
                                                        {
                                                            <button class="ms-btn ms-btn-primary ms-btn-sm font-mono" title="Setujui Reservasi" @onclick='() => UpdateStatus(rsv, "CONFIRMED")'>
                                                                <i class="bi bi-check"></i> Setujui
                                                            </button>
                                                        }
                                                        @if (rsv.Status != "CANCELLED")
                                                        {
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-danger" title="Batalkan Reservasi" @onclick='() => PromptCancelReservation(rsv)'>
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }

                <!-- ========================================================================= -->
                <!-- 3. KATALOG & INTERACTIVE FLOOR PLAN CANVAS (TABLE MANAGEMENT) -->
                <!-- ========================================================================= -->
                @if (ActiveTab == "tables")
                {
                    <div class="row g-4">
                        <!-- Add Table Form -->
                        <div class="col-lg-4">
                            <div class="ms-card p-3.5 mb-4">
                                <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                                    <i class="bi bi-plus-circle text-primary"></i>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.9rem; color: var(--ms-text-main);">Tambah Meja Baru</h6>
                                </div>

                                <form @onsubmit="HandleAddTable">
                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="tableNo">Nomor / Label Meja <span class="text-danger">*</span></label>
                                        <input type="text" class="ms-form-control font-mono" id="tableNo" @bind="NewTableNumber" required placeholder="Contoh: T-01, VIP-01" />
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="tableCap">Kapasitas Kursi <span class="text-danger">*</span></label>
                                        <input type="number" class="ms-form-control font-mono" id="tableCap" @bind="NewTableCapacity" required min="1" max="50" />
                                    </div>

                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="ms-form-label">Posisi X (px)</label>
                                            <input type="number" class="ms-form-control font-mono" @bind="NewTablePosX" min="0" max="600" />
                                        </div>
                                        <div class="col-6">
                                            <label class="ms-form-label">Posisi Y (px)</label>
                                            <input type="number" class="ms-form-control font-mono" @bind="NewTablePosY" min="0" max="400" />
                                        </div>
                                    </div>

                                    <button type="submit" class="ms-btn ms-btn-primary w-100" disabled="@IsSubmitting">
                                        @if (IsSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Menyimpan...</span>
                                        }
                                        else
                                        {
                                            <span>Simpan Meja</span>
                                            <i class="bi bi-check2 ms-1"></i>
                                        }
                                    </button>
                                </form>
                            </div>

                            <!-- Selected Table Quick Coordinate Editor -->
                            @if (SelectedCanvasTable != null)
                            {
                                <div class="ms-card p-3.5 border-primary">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="fw-bold text-primary font-mono">@SelectedCanvasTable.TableNumber (Kapasitas @SelectedCanvasTable.Capacity)</span>
                                        <button class="btn btn-sm btn-link text-muted p-0" @onclick="() => SelectedCanvasTable = null"><i class="bi bi-x"></i></button>
                                    </div>
                                    <div class="small text-muted font-mono mb-2">Geser atau ketik koordinat X/Y:</div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="small font-mono text-muted">X:</label>
                                            <input type="number" class="ms-form-control font-mono ms-form-control-sm" @bind="SelectedCanvasTable.PosX" />
                                        </div>
                                        <div class="col-6">
                                            <label class="small font-mono text-muted">Y:</label>
                                            <input type="number" class="ms-form-control font-mono ms-form-control-sm" @bind="SelectedCanvasTable.PosY" />
                                        </div>
                                    </div>
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm w-100" @onclick="SaveTablePosition">
                                        <i class="bi bi-save me-1"></i> Simpan Posisi Meja
                                    </button>
                                </div>
                            }
                        </div>

                        <!-- Interactive Floor Plan Canvas & Table List -->
                        <div class="col-lg-8">
                            <!-- Visual Canvas Box -->
                            <div class="ms-card p-3 mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-2 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-aspect-ratio text-primary"></i>
                                        <h6 class="ms-card-title mb-0">Visual Floor Plan Canvas</h6>
                                    </div>
                                    <span class="small font-mono text-muted">Klik meja untuk memilih & mengatur posisi</span>
                                </div>

                                <!-- 2D Floor Plan Container (Architect Warm Luxury Grid) -->
                                <div class="p-3 position-relative overflow-hidden rounded"
                                     style="background: #F8F5EE; background-image: radial-gradient(rgba(184, 142, 45, 0.28) 1px, transparent 1px); background-size: 24px 24px; border: 1px solid rgba(184, 142, 45, 0.28); min-height: 320px; height: 340px; box-shadow: inset 0 2px 8px rgba(45,35,20,0.04);">
                                    
                                    @if (!TablesList.Any())
                                    {
                                        <div class="h-100 d-flex flex-column align-items-center justify-content-center text-muted font-mono">
                                            <i class="bi bi-grid-3x3 fs-2 opacity-50 mb-2"></i>
                                            <span>Belum ada meja. Tambahkan meja untuk melihat denah layout.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        @foreach (var tbl in TablesList)
                                        {
                                            var isSel = SelectedCanvasTable?.TableId == tbl.TableId;
                                            var leftPx = Math.Max(10, Math.Min(560, tbl.PosX));
                                            var topPx = Math.Max(10, Math.Min(260, tbl.PosY));

                                            <div class="position-absolute p-2 rounded text-center border font-mono @(isSel ? "border-primary shadow" : "")"
                                                 style="left: @(leftPx)px; top: @(topPx)px; cursor: pointer; transition: all 0.15s ease; min-width: 80px; background: @(isSel ? "#FDF8ED" : "#FFFFFF"); color: @(isSel ? "#8C6819" : "var(--ms-text-main)"); border: @(isSel ? "2px solid #B88E2D !important" : "1px solid rgba(184, 142, 45, 0.35) !important"); box-shadow: 0 4px 12px -2px rgba(45,35,20,0.08);"
                                                 @onclick="() => SelectCanvasTable(tbl)">
                                                <i class="bi bi-square-fill d-block fs-6" style="color: @(isSel ? "#B88E2D" : "#8A7C6D");"></i>
                                                <div class="fw-bold" style="font-size: 0.78rem;">@tbl.TableNumber</div>
                                                <div style="font-size: 0.68rem; color: var(--ms-text-dim);">@tbl.Capacity Kursi</div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Tables Directory Table -->
                            <div class="ms-card">
                                <div class="ms-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-layout-wtf text-primary"></i>
                                        <h6 class="ms-card-title">Katalog Meja Restoran (@TablesList.Count)</h6>
                                    </div>
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="RefreshTables">
                                        <i class="bi bi-arrow-clockwise"></i> Refresh
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="ms-table">
                                        <thead>
                                            <tr>
                                                <th>Nomor Meja</th>
                                                <th>Kapasitas</th>
                                                <th>Status</th>
                                                <th>Koordinat Canvas (X,Y)</th>
                                                <th class="text-end">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!TablesList.Any())
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center py-4" style="color: var(--ms-text-dim);">
                                                        <span>Belum ada meja yang terdaftar.</span>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var tbl in TablesList)
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong class="font-mono" style="color: var(--ms-text-main);">@tbl.TableNumber</strong>
                                                            <small class="d-block font-mono" style="font-size: 0.7rem; color: var(--ms-text-dim);">@tbl.TableId</small>
                                                        </td>
                                                        <td>
                                                            <span class="ms-badge ms-badge-primary font-mono">
                                                                <i class="bi bi-people me-1"></i> @tbl.Capacity Kursi
                                                            </span>
                                                        </td>
                                                        <td>
                                                            @if (tbl.IsActive)
                                                            {
                                                                <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> AKTIF</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="ms-badge ms-badge-neutral">NONAKTIF</span>
                                                            }
                                                        </td>
                                                        <td class="font-mono small" style="color: var(--ms-text-muted);">
                                                            X: @tbl.PosX, Y: @tbl.PosY (@tbl.Rotation&deg;)
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-danger" @onclick="() => PromptDeleteTable(tbl)" title="Hapus Meja">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================================= -->
                <!-- 4. MANAJEMEN MENU & KATEGORI (MENU MANAGEMENT) -->
                <!-- ========================================================================= -->
                @if (ActiveTab == "menu")
                {
                    <div class="row g-4 mb-4">
                        <!-- Left: Add Menu Item Form -->
                        <div class="col-lg-4">
                            <div class="ms-card p-3.5 mb-4">
                                <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                                    <i class="bi bi-plus-circle text-primary"></i>
                                    <h6 class="fw-bold mb-0" style="font-size: 0.9rem; color: var(--ms-text-main);">Tambah Item Menu Baru</h6>
                                </div>

                                <form @onsubmit="HandleAddMenuItem">
                                    <div class="ms-form-group">
                                        <label class="ms-form-label">Nama Menu <span class="text-danger">*</span></label>
                                        <input type="text" class="ms-form-control" @bind="NewMenuItem.Name" required placeholder="Contoh: Nasi Goreng Spesial" />
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label">Kategori <span class="text-danger">*</span></label>
                                        <select class="ms-form-control" @bind="NewMenuItem.Category">
                                            @foreach (var cat in MenuCategories)
                                            {
                                                <option value="@cat.Name">@cat.Name</option>
                                            }
                                        </select>
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label">Harga (IDR) <span class="text-danger">*</span></label>
                                        <input type="number" class="ms-form-control font-mono" @bind="NewMenuItem.Price" required min="0" step="1000" placeholder="45000" />
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label">Deskripsi Menu</label>
                                        <textarea class="ms-form-control" rows="2" @bind="NewMenuItem.Description" placeholder="Komposisi bahan, rasa, dll."></textarea>
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label">Tags (Spicy, Halal, Popular)</label>
                                        <input type="text" class="ms-form-control font-mono" @bind="NewMenuItem.Tags" placeholder="Spicy, Popular" />
                                    </div>

                                    <button type="submit" class="ms-btn ms-btn-primary w-100 mt-2">
                                        <i class="bi bi-plus-lg me-1"></i> Simpan Item Menu
                                    </button>
                                </form>
                            </div>

                            <!-- Bulk Operations Box -->
                            <div class="ms-card p-3.5">
                                <h6 class="fw-bold mb-2" style="font-size: 0.88rem; color: var(--ms-text-main);">Operasi Massal (CSV)</h6>
                                <p class="small text-muted mb-3" style="font-size: 0.76rem;">
                                    Gunakan format CSV standar untuk ekspor cadangan menu atau impor massal ke katalog restoran Anda.
                                </p>
                                <div class="d-flex gap-2">
                                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm w-100" @onclick="ExportMenuCsv">
                                        <i class="bi bi-download me-1"></i> Ekspor CSV
                                    </button>
                                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm w-100" @onclick="ImportMenuSample">
                                        <i class="bi bi-upload me-1"></i> Impor Contoh
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Menu Catalog List -->
                        <div class="col-lg-8">
                            <div class="ms-card p-3.5">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-journal-text text-primary"></i>
                                        <h6 class="ms-card-title mb-0">Daftar Menu Santapan (@MenuItemsList.Count)</h6>
                                    </div>

                                    <!-- Category Filter Pills -->
                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                        <button class="btn btn-sm font-mono @(SelectedMenuCategory == "All" ? "btn-primary" : "btn-outline-secondary")"
                                                style="font-size: 0.72rem; padding: 0.2rem 0.6rem;"
                                                @onclick='() => SelectedMenuCategory = "All"'>
                                            Semua
                                        </button>
                                        @foreach (var cat in MenuCategories)
                                        {
                                            <button class="btn btn-sm font-mono @(SelectedMenuCategory == cat.Name ? "btn-primary" : "btn-outline-secondary")"
                                                    style="font-size: 0.72rem; padding: 0.2rem 0.6rem;"
                                                    @onclick="() => SelectedMenuCategory = cat.Name">
                                                @cat.Name
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="ms-table">
                                        <thead>
                                            <tr>
                                                <th>Menu & Kategori</th>
                                                <th>Harga</th>
                                                <th>Tags</th>
                                                <th>Ketersediaan</th>
                                                <th class="text-end">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var filteredMenu = MenuItemsList
                                                    .Where(m => SelectedMenuCategory == "All" || m.Category == SelectedMenuCategory)
                                                    .ToList();
                                            }

                                            @if (!filteredMenu.Any())
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center py-4 text-muted">
                                                        Belum ada menu pada kategori ini.
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var item in filteredMenu)
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong style="color: var(--ms-text-main);">@item.Name</strong>
                                                            <span class="ms-badge ms-badge-neutral ms-1 font-mono" style="font-size: 0.65rem;">@item.Category</span>
                                                            <div class="small text-muted text-truncate" style="max-width: 250px; font-size: 0.74rem;">@item.Description</div>
                                                        </td>
                                                        <td class="font-mono text-primary fw-bold">
                                                            Rp @item.Price.ToString("N0")
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Tags))
                                                            {
                                                                foreach (var tag in item.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                                                {
                                                                    <span class="badge bg-secondary font-mono me-1" style="font-size: 0.65rem;">@tag.Trim()</span>
                                                                }
                                                            }
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm font-mono @(item.IsAvailable ? "btn-outline-success" : "btn-outline-secondary")"
                                                                    style="font-size: 0.72rem; padding: 0.2rem 0.5rem;"
                                                                    @onclick="() => ToggleMenuAvailability(item)">
                                                                @(item.IsAvailable ? "TERSEDIA ✓" : "HABIS ✗")
                                                            </button>
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-danger" @onclick="() => DeleteMenuItem(item)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ========================================================================= -->
                <!-- 5. KUSTOMISASI BRANDING & VISUAL -->
                <!-- ========================================================================= -->
                @if (ActiveTab == "branding")
                {
                    <div class="row g-4">
                        <div class="col-lg-7">
