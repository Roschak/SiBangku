@page "/admin"
@rendermode InteractiveServer
@using System.Net.Http.Headers
@using System.Text.Json
@using SiBangku.Shared.Models
@inject IHttpClientFactory ClientFactory
@inject NavigationManager Navigation

<PageTitle>Portal Admin Restoran - SiBangku Management System</PageTitle>

@if (!IsLoggedIn)
{
    <!-- Login Screen for Restaurant Client -->
    <div class="min-vh-100 d-flex flex-column justify-content-center py-5" style="background-color: var(--ms-surface-dark);">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-6 col-lg-5 col-xl-4">
                    <div class="text-center mb-4">
                        <a href="/" class="d-inline-flex align-items-center gap-2 text-white text-decoration-none mb-2">
                            <span class="d-inline-flex align-items-center justify-content-center text-primary" 
                                  style="width: 36px; height: 36px; font-size: 1.1rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-sm);">
                                <i class="bi bi-shop"></i>
                            </span>
                            <span class="fs-5 fw-bold tracking-tight text-white">SiBangku Resto</span>
                        </a>
                        <div class="font-mono text-muted" style="font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;">Outlet Management & Reservations</div>
                    </div>

                    <div class="ms-card p-4 p-md-4.5" style="background-color: var(--ms-surface-card); border: 1px solid var(--ms-border);">
                        @if (!string.IsNullOrEmpty(LoginError))
                        {
                            <div class="ms-alert ms-alert-danger mb-3">
                                <i class="bi bi-exclamation-octagon-fill ms-alert-icon"></i>
                                <div class="ms-alert-content">
                                    <div class="ms-alert-title">Autentikasi Gagal</div>
                                    <div>@LoginError</div>
                                </div>
                                <button type="button" class="ms-alert-close" @onclick="() => LoginError = null">
                                    <i class="bi bi-x"></i>
                                </button>
                            </div>
                        }

                        <form @onsubmit="HandleLogin">
                            <div class="ms-form-group">
                                <label class="ms-form-label" for="tenantCode">
                                    <i class="bi bi-tag me-1 text-primary"></i> Kode Outlet Restoran <span class="text-danger">*</span>
                                </label>
                                <div class="ms-input-group">
                                    <i class="bi bi-shop ms-input-icon"></i>
                                    <input type="text" class="ms-form-control has-icon-left font-mono fw-bold text-uppercase @(HasAttemptedLogin && string.IsNullOrWhiteSpace(TenantCode) ? "is-invalid" : "")" 
                                           id="tenantCode" name="tenantCode" autocomplete="organization" @bind="TenantCode" placeholder="KODE RESTORAN" />
                                </div>
                            </div>

                            <div class="ms-form-group">
                                <label class="ms-form-label" for="loginEmail">
                                    <i class="bi bi-envelope me-1 text-primary"></i> Email Administrator <span class="text-danger">*</span>
                                </label>
                                <div class="ms-input-group">
                                    <i class="bi bi-person ms-input-icon"></i>
                                    <input type="email" class="ms-form-control has-icon-left @(HasAttemptedLogin && string.IsNullOrWhiteSpace(Email) ? "is-invalid" : "")" 
                                           id="loginEmail" name="username" autocomplete="username" @bind="Email" placeholder="admin@outlet.com" />
                                </div>
                            </div>

                            <div class="ms-form-group mb-4">
                                <label class="ms-form-label" for="loginPassword">
                                    <i class="bi bi-key me-1 text-primary"></i> Kata Sandi <span class="text-danger">*</span>
                                </label>
                                <div class="ms-input-group">
                                    <i class="bi bi-lock ms-input-icon"></i>
                                    <input type="password" class="ms-form-control has-icon-left @(HasAttemptedLogin && string.IsNullOrWhiteSpace(Password) ? "is-invalid" : "")" 
                                           id="loginPassword" name="password" autocomplete="current-password" @bind="Password" placeholder="Masukkan kata sandi" />
                                </div>
                            </div>

                            <button type="submit" class="ms-btn ms-btn-primary w-100" disabled="@IsSubmitting">
                                @if (IsSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Memverifikasi...</span>
                                }
                                else
                                {
                                    <span>Masuk ke Dashboard Resto</span>
                                    <i class="bi bi-arrow-right ms-1"></i>
                                }
                            </button>
                        </form>

                        <div class="mt-4 pt-3 text-center" style="border-top: 1px solid var(--ms-border);">
                            <a href="/" class="small text-decoration-none" style="color: var(--ms-text-muted);">
                                <i class="bi bi-arrow-left me-1"></i> Kembali ke Beranda Publik
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Restaurant Management System Portal Layout -->
    <div class="ms-admin-wrapper" style="--ms-primary: @Branding.PrimaryColor; --ms-primary-hover: @Branding.SecondaryColor;">
        <!-- Left Sidebar -->
        <aside class="ms-sidebar">
            <div class="ms-sidebar-brand">
                <div class="ms-sidebar-brand-icon">
                    <i class="bi bi-shop text-primary"></i>
                </div>
                <div class="overflow-hidden">
                    <h6 class="ms-sidebar-brand-title text-truncate">@(ActiveTenant?.RestaurantName ?? "Resto Admin")</h6>
                    <span class="ms-sidebar-brand-subtitle font-mono">@TenantCode</span>
                </div>
            </div>

            <div class="ms-sidebar-nav">
                <div class="ms-sidebar-section-title">Operasional</div>
                
                <button class="ms-sidebar-item @(ActiveTab == "overview" ? "active" : "")" @onclick='() => SwitchTab("overview")'>
                    <i class="bi bi-grid-1x2"></i>
                    <span>Ringkasan & Metrik</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "reservations" ? "active" : "")" @onclick='() => SwitchTab("reservations")'>
                    <i class="bi bi-calendar-check"></i>
                    <span>Kelola Reservasi</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "tables" ? "active" : "")" @onclick='() => SwitchTab("tables")'>
                    <i class="bi bi-layout-wtf"></i>
                    <span>Katalog Meja</span>
                </button>

                <div class="ms-sidebar-section-title">Visual & Standee</div>

                <button class="ms-sidebar-item @(ActiveTab == "qrcode" ? "active" : "")" @onclick='() => SwitchTab("qrcode")'>
                    <i class="bi bi-qr-code-scan"></i>
                    <span>Standee QR Cetak</span>
                </button>

                <button class="ms-sidebar-item @(ActiveTab == "branding" ? "active" : "")" @onclick='() => SwitchTab("branding")'>
                    <i class="bi bi-sliders"></i>
                    <span>Pengaturan Outlet</span>
                </button>
            </div>

            <div class="ms-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center gap-2 overflow-hidden">
                        <div class="d-flex align-items-center justify-content-center fw-bold font-mono" 
                             style="width: 28px; height: 28px; font-size: 0.75rem; background: var(--ms-surface-elevated); border: 1px solid var(--ms-border); border-radius: var(--ms-radius-xs); color: var(--ms-primary);">
                            <i class="bi bi-person"></i>
                        </div>
                        <div class="overflow-hidden">
                            <div class="text-white small fw-bold text-truncate">@Email</div>
                            <div class="font-mono text-truncate" style="font-size: 0.68rem; color: var(--ms-text-dim);">Admin Mitra</div>
                        </div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-2">
                    <a href="/" class="ms-btn ms-btn-secondary ms-btn-sm w-100" title="Ke Beranda Tamu">
                        <i class="bi bi-house"></i>
                    </a>
                    <button class="ms-btn ms-btn-danger ms-btn-sm w-100" @onclick="HandleLogout" title="Logout">
                        <i class="bi bi-box-arrow-right"></i> Keluar
                    </button>
                </div>
            </div>
        </aside>

        <!-- Main Workspace -->
        <main class="ms-admin-main">
            <!-- Topbar -->
            <header class="ms-admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <h6 class="fw-bold mb-0 text-white" style="font-size: 0.95rem;">
                        @if (ActiveTab == "overview") { <span>Ringkasan Operasional Restoran</span> }
                        else if (ActiveTab == "reservations") { <span>Daftar Reservasi Meja</span> }
                        else if (ActiveTab == "tables") { <span>Katalog & Denah Meja Restoran</span> }
                        else if (ActiveTab == "qrcode") { <span>Generator Standee & QR Code Cetak</span> }
                        else if (ActiveTab == "branding") { <span>Kustomisasi Tema & Jam Operasional</span> }
                    </h6>
                    <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> Outlet Online</span>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="RefreshReservations">
                        <i class="bi bi-arrow-clockwise"></i> Refresh
                    </button>
                    <a href="/booking?tenant=@TenantCode" target="_blank" class="ms-btn ms-btn-primary ms-btn-sm">
                        <i class="bi bi-arrow-up-right"></i> Portal Pelanggan
                    </a>
                </div>
            </header>

            <!-- Body Content Area -->
            <div class="ms-admin-content">
                <!-- Action Alerts -->
                @if (!string.IsNullOrEmpty(SuccessAlert))
                {
                    <div class="ms-alert ms-alert-success mb-4 shadow-sm">
                        <i class="bi bi-check-circle-fill ms-alert-icon"></i>
                        <div class="ms-alert-content">
                            <div class="ms-alert-title">Berhasil</div>
                            <div>@SuccessAlert</div>
                        </div>
                        <button type="button" class="ms-alert-close" @onclick="() => SuccessAlert = null">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(ErrorAlert))
                {
                    <div class="ms-alert ms-alert-danger mb-4 shadow-sm">
                        <i class="bi bi-exclamation-octagon-fill ms-alert-icon"></i>
                        <div class="ms-alert-content">
                            <div class="ms-alert-title">Perhatian</div>
                            <div>@ErrorAlert</div>
                        </div>
                        <button type="button" class="ms-alert-close" @onclick="() => ErrorAlert = null">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }

                @if (ActiveTab == "overview" || ActiveTab == "reservations")
                {
                    <!-- Stat Cards Row -->
                    <div class="row g-3 mb-4">
                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Total Pemesanan</span>
                                    <div class="ms-stat-icon">
                                        <i class="bi bi-calendar2-range"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value">@ReservationsList.Count</div>
                                <p class="ms-stat-hint">Seluruh jadwal reservasi</p>
                            </div>
                        </div>

                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Menunggu Konfirmasi</span>
                                    <div class="ms-stat-icon text-warning">
                                        <i class="bi bi-hourglass-split"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value text-warning">@ReservationsList.Count(r => r.Status == "PENDING")</div>
                                <p class="ms-stat-hint">Perlu tindakan verifikasi staff</p>
                            </div>
                        </div>

                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Terkonfirmasi</span>
                                    <div class="ms-stat-icon text-success">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value text-success">@ReservationsList.Count(r => r.Status == "CONFIRMED")</div>
                                <p class="ms-stat-hint">Siap menyambut kedatangan tamu</p>
                            </div>
                        </div>

                        <div class="col-xl-3 col-sm-6">
                            <div class="ms-stat-card">
                                <div class="ms-stat-header">
                                    <span class="ms-stat-title">Batal / Timeout</span>
                                    <div class="ms-stat-icon text-danger">
                                        <i class="bi bi-x-circle"></i>
                                    </div>
                                </div>
                                <div class="ms-stat-value text-danger">@ReservationsList.Count(r => r.Status == "CANCELLED" || r.Status == "EXPIRED")</div>
                                <p class="ms-stat-hint">Dibatalkan atau timeout pembayaran</p>
                            </div>
                        </div>
                    </div>
                }

                @if (ActiveTab == "overview" || ActiveTab == "reservations")
                {
                    <!-- Reservations Table Card -->
                    <div class="ms-card">
                        <div class="ms-card-header flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-table text-primary"></i>
                                <h6 class="ms-card-title">Jadwal Reservasi Pelanggan</h6>
                            </div>
                            
                            <!-- Search & Filter Controls -->
                            <div class="d-flex align-items-center gap-2">
                                <div class="ms-input-group">
                                    <i class="bi bi-search ms-input-icon"></i>
                                    <input type="text" class="ms-form-control ms-form-control-sm has-icon-left font-mono" 
                                           @bind="SearchReservationQuery" @bind:event="oninput" 
                                           placeholder="Cari kode / tamu..." style="max-width: 220px; font-size: 0.8rem;" />
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="ms-table">
                                <thead>
                                    <tr>
                                        <th>Kode Booking</th>
                                        <th>Catatan & Tamu</th>
                                        <th>Jadwal Reservasi</th>
                                        <th>Status Bayar</th>
                                        <th>Status Reservasi</th>
                                        <th class="text-end">Tindakan Staff</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var filtered = ReservationsList
                                            .Where(r => string.IsNullOrEmpty(SearchReservationQuery) || 
                                                        r.ReservationNumber.Contains(SearchReservationQuery, StringComparison.OrdinalIgnoreCase) ||
                                                        r.Notes.Contains(SearchReservationQuery, StringComparison.OrdinalIgnoreCase))
                                            .ToList();
                                    }

                                    @if (!filtered.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5" style="color: var(--ms-text-dim);">
                                                <i class="bi bi-inbox fs-3 d-block mb-2 opacity-50"></i>
                                                <span>Belum ada reservasi tercatat untuk filter ini.</span>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var rsv in filtered)
                                        {
                                            <tr>
                                                <td>
                                                    <strong class="text-primary font-mono fs-6">@rsv.ReservationNumber</strong>
                                                    <small class="d-block font-mono" style="font-size: 0.7rem; color: var(--ms-text-dim);">@rsv.Id</small>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-white"><i class="bi bi-people me-1 text-primary"></i> @rsv.GuestCount Orang</div>
                                                    <small class="text-truncate d-block" style="max-width: 200px; color: var(--ms-text-dim);">
                                                        @(string.IsNullOrEmpty(rsv.Notes) ? "Tanpa catatan" : rsv.Notes)
                                                    </small>
                                                </td>
                                                <td>
                                                    <div class="fw-semibold text-white font-mono"><i class="bi bi-calendar3 me-1 text-primary"></i> @rsv.Date.ToString("yyyy-MM-dd")</div>
                                                    <small class="font-mono" style="color: var(--ms-text-dim);"><i class="bi bi-clock me-1"></i> @rsv.StartTime.ToString(@"hh\:mm") - @rsv.EndTime.ToString(@"hh\:mm") WIB</small>
                                                </td>
                                                <td>
                                                    @if (rsv.PaymentStatus == "PAID")
                                                    {
                                                        <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> LUNAS</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ms-badge ms-badge-warning"><span class="ms-badge-dot"></span> BELUM BAYAR</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (rsv.Status == "CONFIRMED")
                                                    {
                                                        <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> CONFIRMED</span>
                                                    }
                                                    else if (rsv.Status == "PENDING")
                                                    {
                                                        <span class="ms-badge ms-badge-warning"><span class="ms-badge-dot"></span> PENDING</span>
                                                    }
                                                    else if (rsv.Status == "CANCELLED" || rsv.Status == "EXPIRED")
                                                    {
                                                        <span class="ms-badge ms-badge-danger">@rsv.Status</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="ms-badge ms-badge-neutral">@rsv.Status</span>
                                                    }
                                                </td>
                                                <td class="text-end">
                                                    <div class="d-inline-flex gap-1.5">
                                                        @if (rsv.PaymentStatus != "PAID")
                                                        {
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-success font-mono" title="Tandai Lunas" @onclick='() => UpdatePayment(rsv, "PAID")'>
                                                                <i class="bi bi-cash-stack"></i> Lunas
                                                            </button>
                                                        }
                                                        @if (rsv.Status == "PENDING")
                                                        {
                                                            <button class="ms-btn ms-btn-primary ms-btn-sm font-mono" title="Setujui Reservasi" @onclick='() => UpdateStatus(rsv, "CONFIRMED")'>
                                                                <i class="bi bi-check"></i> Setujui
                                                            </button>
                                                        }
                                                        @if (rsv.Status != "CANCELLED")
                                                        {
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-danger" title="Batalkan Reservasi" @onclick='() => PromptCancelReservation(rsv)'>
                                                                <i class="bi bi-x"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else if (ActiveTab == "tables")
                {
                    <!-- Tables Management Tab -->
                    <div class="row g-4">
                        <!-- Add Table Form -->
                        <div class="col-lg-4">
                            <div class="ms-card p-3.5">
                                <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                                    <i class="bi bi-plus-circle text-primary"></i>
                                    <h6 class="fw-bold text-white mb-0" style="font-size: 0.9rem;">Tambah Meja Baru</h6>
                                </div>

                                <form @onsubmit="HandleAddTable">
                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="tableNo">Nomor / Label Meja <span class="text-danger">*</span></label>
                                        <input type="text" class="ms-form-control font-mono" id="tableNo" @bind="NewTableNumber" required placeholder="Contoh: T-01, VIP-A" />
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="tableCap">Kapasitas Kursi <span class="text-danger">*</span></label>
                                        <input type="number" class="ms-form-control font-mono" id="tableCap" @bind="NewTableCapacity" required min="1" max="50" />
                                    </div>

                                    <button type="submit" class="ms-btn ms-btn-primary w-100 mt-2" disabled="@IsSubmitting">
                                        @if (IsSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Menyimpan...</span>
                                        }
                                        else
                                        {
                                            <span>Simpan Meja</span>
                                            <i class="bi bi-check2 ms-1"></i>
                                        }
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Tables Directory -->
                        <div class="col-lg-8">
                            <div class="ms-card">
                                <div class="ms-card-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-layout-wtf text-primary"></i>
                                        <h6 class="ms-card-title">Katalog Meja Restoran (@TablesList.Count)</h6>
                                    </div>
                                    <button class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="RefreshTables">
                                        <i class="bi bi-arrow-clockwise"></i> Refresh
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="ms-table">
                                        <thead>
                                            <tr>
                                                <th>Nomor Meja</th>
                                                <th>Kapasitas</th>
                                                <th>Status</th>
                                                <th>Posisi Layout (X,Y)</th>
                                                <th class="text-end">Aksi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!TablesList.Any())
                                            {
                                                <tr>
                                                    <td colspan="5" class="text-center py-5" style="color: var(--ms-text-dim);">
                                                        <span>Belum ada meja yang terdaftar. Tambahkan meja pertama Anda di sebelah kiri.</span>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                @foreach (var tbl in TablesList)
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong class="text-white font-mono">@tbl.TableNumber</strong>
                                                            <small class="d-block font-mono" style="font-size: 0.7rem; color: var(--ms-text-dim);">@tbl.TableId</small>
                                                        </td>
                                                        <td>
                                                            <span class="ms-badge ms-badge-primary font-mono">
                                                                <i class="bi bi-people me-1"></i> @tbl.Capacity Kursi
                                                            </span>
                                                        </td>
                                                        <td>
                                                            @if (tbl.IsActive)
                                                            {
                                                                <span class="ms-badge ms-badge-success"><span class="ms-badge-dot"></span> AKTIF</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="ms-badge ms-badge-neutral">NONAKTIF</span>
                                                            }
                                                        </td>
                                                        <td class="font-mono small" style="color: var(--ms-text-muted);">
                                                            X: @tbl.PosX, Y: @tbl.PosY (@tbl.Rotation&deg;)
                                                        </td>
                                                        <td class="text-end">
                                                            <button class="ms-btn ms-btn-secondary ms-btn-sm text-danger" @onclick="() => PromptDeleteTable(tbl)" title="Hapus Meja">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (ActiveTab == "qrcode")
                {
                    <!-- QR Poster Standee Kit -->
                    <div class="ms-card p-4">
                        <div class="text-center mb-4">
                            <span class="ms-badge ms-badge-primary mb-2">Hospitality Standee Kit</span>
                            <h5 class="fw-bold text-white mb-1">Poster QR Code Reservasi Mandiri</h5>
                            <p class="small" style="color: var(--ms-text-dim); max-width: 520px; margin: 0 auto;">
                                Cetak poster ini untuk akrilik meja atau banner resepsionis. Tamu dapat langsung memindai kamera HP untuk memesan meja secara mandiri.
                            </p>
                        </div>

                        <div class="ms-print-area my-4">
                            <div class="ms-poster-card" style="border: 2px solid var(--ms-border); background-color: #FFFFFF; color: #0A0D14; border-radius: var(--ms-radius-md);">
                                <div class="d-inline-flex align-items-center justify-content-center text-primary mb-3" 
                                     style="width: 48px; height: 48px; font-size: 1.4rem; background: #F3F4F6; border: 1px solid #E5E7EB; border-radius: var(--ms-radius-sm);">
                                    <i class="bi bi-shop"></i>
                                </div>
                                <h4 class="fw-bold text-uppercase mb-1" style="letter-spacing: -0.01em; color: #111827;">
                                    SCAN & PESAN MEJA
                                </h4>
                                <p class="small mb-4" style="color: #6B7280;">Reservasi Mandiri di @(ActiveTenant?.RestaurantName ?? "Restoran Kami")</p>

                                <div class="p-3 bg-white rounded-3 d-inline-block border mb-4" style="border-color: #E5E7EB !important;">
                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=@(Uri.EscapeDataString(GetBookingUrl()))" 
                                         alt="QR Code Pemesanan" style="width: 180px; height: 180px;" />
                                </div>

                                <div class="small fw-semibold mb-1" style="color: #111827;">Kode Outlet: <strong class="font-mono text-primary">@TenantCode</strong></div>
                                <p class="small mb-4" style="font-size: 0.78rem; color: #6B7280;">Arahkan kamera HP Anda ke QR Code untuk melihat denah meja dan memilih slot waktu.</p>

                                <div class="pt-3 font-mono" style="font-size: 0.7rem; color: #9CA3AF; border-top: 1px solid #E5E7EB;">
                                    Powered by <strong>SiBangku Platform</strong>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <button class="ms-btn ms-btn-primary" onclick="window.print()">
                                <i class="bi bi-printer me-1"></i> Cetak / Simpan PDF
                            </button>
                        </div>
                    </div>
                }
                else if (ActiveTab == "branding")
                {
                    <!-- Settings & Branding -->
                    <div class="ms-card p-4">
                        <div class="d-flex align-items-center gap-2 mb-4 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                            <i class="bi bi-sliders text-primary fs-5"></i>
                            <h6 class="fw-bold text-white mb-0" style="font-size: 0.95rem;">Kustomisasi Tema & Jam Operasional</h6>
                        </div>

                        <form @onsubmit="SaveSettings">
                            <div class="row g-4">
                                <div class="col-lg-6">
                                    <h6 class="fw-bold text-white mb-3" style="font-size: 0.85rem;">
                                        <i class="bi bi-palette text-primary me-1"></i> Palet Warna Visual Restoran:
                                    </h6>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="primaryColor">Warna Utama (Primary)</label>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color border-0 p-1" id="primaryColor" @bind="Branding.PrimaryColor" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-xs);" />
                                            <input type="text" class="ms-form-control font-mono" @bind="Branding.PrimaryColor" placeholder="#6366F1" />
                                        </div>
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="secondaryColor">Warna Sekunder (Secondary)</label>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color border-0 p-1" id="secondaryColor" @bind="Branding.SecondaryColor" style="background: var(--ms-surface-input); border-radius: var(--ms-radius-xs);" />
                                            <input type="text" class="ms-form-control font-mono" @bind="Branding.SecondaryColor" placeholder="#4F46E5" />
                                        </div>
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="fontSelect">Tipografi / Font</label>
                                        <select class="ms-form-control" id="fontSelect" @bind="Branding.Font">
                                            <option value="Plus Jakarta Sans">Plus Jakarta Sans (Rekomendasi)</option>
                                            <option value="Inter">Inter</option>
                                            <option value="JetBrains Mono">JetBrains Mono</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-6">
                                    <h6 class="fw-bold text-white mb-3" style="font-size: 0.85rem;">
                                        <i class="bi bi-clock text-primary me-1"></i> Jam Operasional & Kuota:
                                    </h6>

                                    <div class="row g-3">
                                        <div class="col-6">
                                            <div class="ms-form-group">
                                                <label class="ms-form-label" for="openTime">Jam Buka</label>
                                                <input type="text" class="ms-form-control font-mono" id="openTime" @bind="TimeSlots.OpeningTime" placeholder="08:00" />
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="ms-form-group">
                                                <label class="ms-form-label" for="closeTime">Jam Tutup</label>
                                                <input type="text" class="ms-form-control font-mono" id="closeTime" @bind="TimeSlots.ClosingTime" placeholder="22:00" />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="durationSlot">Durasi Slot Makan (Menit)</label>
                                        <input type="number" class="ms-form-control font-mono" id="durationSlot" @bind="TimeSlots.SlotDuration" min="30" max="240" />
                                    </div>

                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="maxCovers">Batas Maksimal Tamu per Jam</label>
                                        <input type="number" class="ms-form-control font-mono" id="maxCovers" @bind="TimeSlots.MaxConcurrentCovers" min="5" />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-4 pt-3" style="border-top: 1px solid var(--ms-border);">
                                <button type="submit" class="ms-btn ms-btn-primary" disabled="@IsSubmitting">
                                    @if (IsSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Menyimpan...</span>
                                    }
                                    else
                                    {
                                        <span>Simpan Konfigurasi Resto</span>
                                        <i class="bi bi-check2 ms-1"></i>
                                    }
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Outlet Admin Password Change Card -->
                    <div class="ms-card p-4 mt-4">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-2" style="border-bottom: 1px solid var(--ms-border);">
                            <i class="bi bi-shield-lock text-warning fs-5"></i>
                            <h6 class="fw-bold text-white mb-0" style="font-size: 0.95rem;">Ganti Kata Sandi Administrator Outlet</h6>
                        </div>
                        <p class="small mb-3" style="color: var(--ms-text-dim);">
                            Perbarui kata sandi akun administrator untuk outlet <strong>@(ActiveTenant?.RestaurantName ?? TenantCode)</strong>. Minimal 5 karakter.
                        </p>

                        <form @onsubmit="HandleChangeTenantPassword">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="tenantNewPw">Kata Sandi Baru <span class="text-danger">*</span></label>
                                        <input type="password" class="ms-form-control font-mono" id="tenantNewPw" @bind="TenantNewPassword" required minlength="5" placeholder="Minimal 5 karakter" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="ms-form-group">
                                        <label class="ms-form-label" for="tenantConfirmPw">Konfirmasi Kata Sandi Baru <span class="text-danger">*</span></label>
                                        <input type="password" class="ms-form-control font-mono" id="tenantConfirmPw" @bind="TenantConfirmPassword" required minlength="5" placeholder="Ulangi kata sandi baru" />
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-3 pt-2">
                                <button type="submit" class="ms-btn ms-btn-primary" disabled="@IsSubmitting">
                                    @if (IsSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Menyimpan Password...</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-key me-1"></i>
                                        <span>Perbarui Kata Sandi Admin Resto</span>
                                    }
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </main>
    </div>

    <!-- MODAL: Delete Table Verification Modal -->
    @if (DeleteTargetTable != null)
    {
        <div class="ms-modal-backdrop" @onclick="() => DeleteTargetTable = null">
            <div class="ms-modal-card" style="border-color: var(--ms-danger);" @onclick:stopPropagation="true">
                <div class="ms-modal-header">
                    <h6 class="ms-modal-title text-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i> Konfirmasi Hapus Meja
                    </h6>
                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="() => DeleteTargetTable = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="ms-modal-body">
                    <p class="mb-0">
                        Apakah Anda yakin ingin menghapus meja <strong>@DeleteTargetTable.TableNumber</strong> (Kapasitas @DeleteTargetTable.Capacity Kursi)?
                    </p>
                </div>
                <div class="ms-modal-footer">
                    <button type="button" class="ms-btn ms-btn-secondary" @onclick="() => DeleteTargetTable = null">Batal</button>
                    <button type="button" class="ms-btn ms-btn-danger" @onclick="HandleConfirmDeleteTable" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Menghapus...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash-fill me-1"></i>
                            <span>Hapus Meja</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: Cancel Reservation Verification Modal -->
    @if (CancelTargetReservation != null)
    {
        <div class="ms-modal-backdrop" @onclick="() => CancelTargetReservation = null">
            <div class="ms-modal-card" style="border-color: var(--ms-warning);" @onclick:stopPropagation="true">
                <div class="ms-modal-header">
                    <h6 class="ms-modal-title text-warning">
                        <i class="bi bi-x-circle-fill"></i> Konfirmasi Pembatalan Reservasi
                    </h6>
                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="() => CancelTargetReservation = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="ms-modal-body">
                    <p class="mb-2">
                        Apakah Anda yakin ingin membatalkan jadwal booking kode <strong class="font-mono text-primary">@CancelTargetReservation.ReservationNumber</strong>?
                    </p>
                    <div class="small text-muted font-mono">
                        Tanggal: @CancelTargetReservation.Date.ToString("yyyy-MM-dd") (@CancelTargetReservation.StartTime.ToString(@"hh\:mm") - @CancelTargetReservation.EndTime.ToString(@"hh\:mm") WIB) • @CancelTargetReservation.GuestCount Tamu
                    </div>
                </div>
                <div class="ms-modal-footer">
                    <button type="button" class="ms-btn ms-btn-secondary" @onclick="() => CancelTargetReservation = null">Batal</button>
                    <button type="button" class="ms-btn ms-btn-danger" @onclick="HandleConfirmCancelReservation" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Membatalkan...</span>
                        }
                        else
                        {
                            <i class="bi bi-x-lg me-1"></i>
                            <span>Batalkan Reservasi</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool IsLoggedIn = false;
    private bool HasAttemptedLogin = false;
    private string TenantCode = "";
    private string Email = "";
    private string Password = "";
    private string? LoginError;
    
    // Global Alerts
    private string? SuccessAlert;
    private string? ErrorAlert;

    private string Token = "";
    private bool IsSubmitting = false;
    private string ActiveTab = "overview";
    private string SearchReservationQuery = "";

    // Add Table Form model
    private string NewTableNumber = "";
    private int NewTableCapacity = 4;

    // Interactive Verification Modals
    private Table? DeleteTargetTable;
    private Reservation? CancelTargetReservation;

    private Tenant? ActiveTenant;
    private List<Reservation> ReservationsList = new List<Reservation>();
    private List<Table> TablesList = new List<Table>();

    public class BrandingConfig
    {
        public string PrimaryColor { get; set; } = "#6366F1";
        public string SecondaryColor { get; set; } = "#4F46E5";
        public string Font { get; set; } = "Plus Jakarta Sans";
    }

    public class TimeSlotsConfig
    {
        public int SlotDuration { get; set; } = 60;
        public int MaxConcurrentCovers { get; set; } = 30;
        public string OpeningTime { get; set; } = "08:00";
        public string ClosingTime { get; set; } = "22:00";
    }

    private BrandingConfig Branding = new BrandingConfig();
    private TimeSlotsConfig TimeSlots = new TimeSlotsConfig();

    private HttpClient GetClient()
    {
        var client = ClientFactory.CreateClient("TenantApi");
        client.DefaultRequestHeaders.Clear();
        if (!string.IsNullOrWhiteSpace(TenantCode))
        {
            client.DefaultRequestHeaders.Add("x-tenant-code", TenantCode.Trim().ToUpperInvariant());
        }
        if (!string.IsNullOrEmpty(Token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token);
        }
        return client;
    }

    private string GetBookingUrl()
    {
        return $"{Navigation.BaseUri}booking?tenant={TenantCode}";
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
        SuccessAlert = null;
        ErrorAlert = null;
        if (IsLoggedIn)
        {
            if (tab == "reservations" || tab == "overview") _ = RefreshReservations();
            if (tab == "tables") _ = RefreshTables();
        }
    }

    private async Task HandleLogin()
    {
        HasAttemptedLogin = true;
        LoginError = null;

        if (string.IsNullOrWhiteSpace(TenantCode) || string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            LoginError = "Harap isi Kode Restoran, Email Admin, dan Kata Sandi.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.PostAsJsonAsync("/api/v1/auth/login", new { email = Email.Trim(), password = Password });
            
            if (response.IsSuccessStatusCode)
            {
                var doc = await response.Content.ReadFromJsonAsync<JsonElement>();
                Token = doc.GetProperty("data").GetProperty("token").GetString() ?? "";
                IsLoggedIn = true;
                
                await LoadTenantData();
            }
            else
            {
                LoginError = "Kredensial tidak valid. Pastikan Kode Restoran, Email, dan Kata Sandi benar.";
            }
        }
        catch (Exception ex)
        {
            LoginError = $"Gagal terhubung ke API Resto: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
            StateHasChanged();
        }
    }

    private void HandleLogout()
    {
        IsLoggedIn = false;
        Token = "";
        ReservationsList.Clear();
        TablesList.Clear();
        ActiveTenant = null;
    }

    private async Task LoadTenantData()
    {
        try
        {
            var client = GetClient();
            var res = await client.GetAsync("/api/v1/branding");
            if (res.IsSuccessStatusCode)
            {
                var doc = await res.Content.ReadFromJsonAsync<JsonElement>();
                var data = doc.GetProperty("data");
                ActiveTenant = JsonSerializer.Deserialize<Tenant>(data.GetProperty("tenant").GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                Branding = JsonSerializer.Deserialize<BrandingConfig>(data.GetProperty("branding").GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new BrandingConfig();
                TimeSlots = JsonSerializer.Deserialize<TimeSlotsConfig>(data.GetProperty("timeSlots").GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new TimeSlotsConfig();
            }

            await RefreshReservations();
            await RefreshTables();
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Gagal memuat data tenant: {ex.Message}";
        }
    }

    private async Task RefreshReservations()
    {
        try
        {
            var client = GetClient();
            var res = await client.GetAsync("/api/v1/reservations");
            if (res.IsSuccessStatusCode)
            {
                var doc = await res.Content.ReadFromJsonAsync<JsonElement>();
                var array = doc.GetProperty("data");
                ReservationsList = JsonSerializer.Deserialize<List<Reservation>>(array.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<Reservation>();
            }
        }
        catch { }
    }

    private async Task RefreshTables()
    {
        try
        {
            var client = GetClient();
            var res = await client.GetAsync("/api/v1/tables");
            if (res.IsSuccessStatusCode)
            {
                var doc = await res.Content.ReadFromJsonAsync<JsonElement>();
                var array = doc.GetProperty("data");
                TablesList = JsonSerializer.Deserialize<List<Table>>(array.GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new List<Table>();
            }
        }
        catch { }
    }

    private async Task HandleAddTable()
    {
        SuccessAlert = null;
        ErrorAlert = null;

        if (string.IsNullOrWhiteSpace(NewTableNumber))
        {
            ErrorAlert = "Nomor / Label meja tidak boleh kosong.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var payload = new 
            { 
                tableNumber = NewTableNumber.Trim().ToUpperInvariant(), 
                capacity = NewTableCapacity,
                posX = 50,
                posY = 50,
                rotation = 0
            };
            var res = await client.PostAsJsonAsync("/api/v1/tables", payload);
            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = $"Meja '{NewTableNumber.Trim().ToUpperInvariant()}' (Kapasitas {NewTableCapacity} Kursi) berhasil ditambahkan!";
                NewTableNumber = "";
                NewTableCapacity = 4;
                await RefreshTables();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                ErrorAlert = $"Gagal menambah meja: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private void PromptDeleteTable(Table table)
    {
        DeleteTargetTable = table;
    }

    private async Task HandleConfirmDeleteTable()
    {
        if (DeleteTargetTable == null) return;
        SuccessAlert = null;
        ErrorAlert = null;

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var res = await client.DeleteAsync($"/api/v1/tables/{DeleteTargetTable.TableId}");
            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = $"Meja '{DeleteTargetTable.TableNumber}' berhasil dihapus.";
                DeleteTargetTable = null;
                await RefreshTables();
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                ErrorAlert = $"Gagal menghapus meja: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Gagal: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task UpdatePayment(Reservation rsv, string status)
    {
        SuccessAlert = null;
        ErrorAlert = null;
        try
        {
            var client = GetClient();
            var res = await client.PatchAsJsonAsync($"/api/v1/reservations/{rsv.Id}/payment", new { paymentStatus = status });
            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = $"Status pembayaran untuk reservasi {rsv.ReservationNumber} berhasil diubah menjadi {status}!";
                await RefreshReservations();
            }
            else
            {
                ErrorAlert = "Gagal memperbarui status pembayaran.";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Gagal: {ex.Message}";
        }
    }

    private async Task UpdateStatus(Reservation rsv, string status)
    {
        SuccessAlert = null;
        ErrorAlert = null;
        try
        {
            var client = GetClient();
            var res = await client.PatchAsJsonAsync($"/api/v1/reservations/{rsv.Id}/status", new { status = status });
            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = $"Reservasi {rsv.ReservationNumber} berhasil disetujui & status diubah menjadi {status}!";
                await RefreshReservations();
            }
            else
            {
                ErrorAlert = "Gagal mengubah status reservasi.";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Gagal: {ex.Message}";
        }
    }

    private void PromptCancelReservation(Reservation rsv)
    {
        CancelTargetReservation = rsv;
    }

    private async Task HandleConfirmCancelReservation()
    {
        if (CancelTargetReservation == null) return;
        SuccessAlert = null;
        ErrorAlert = null;

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var res = await client.PatchAsJsonAsync($"/api/v1/reservations/{CancelTargetReservation.Id}/status", new { status = "CANCELLED" });
            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = $"Reservasi {CancelTargetReservation.ReservationNumber} berhasil dibatalkan.";
                CancelTargetReservation = null;
                await RefreshReservations();
            }
            else
            {
                ErrorAlert = "Gagal membatalkan reservasi.";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Gagal: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private async Task SaveSettings()
    {
        SuccessAlert = null;
        ErrorAlert = null;
        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var payload = new 
            { 
                branding = Branding, 
                timeSlots = TimeSlots 
            };
            var res = await client.PutAsJsonAsync("/api/v1/branding", payload);
            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = "Pengaturan branding dan jam operasional outlet berhasil disimpan!";
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                ErrorAlert = $"Gagal menyimpan pengaturan: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    private string TenantNewPassword = "";
    private string TenantConfirmPassword = "";

    private async Task HandleChangeTenantPassword()
    {
        SuccessAlert = null;
        ErrorAlert = null;

        if (string.IsNullOrWhiteSpace(TenantNewPassword) || string.IsNullOrWhiteSpace(TenantConfirmPassword))
        {
            ErrorAlert = "Kata sandi baru dan konfirmasi wajib diisi.";
            return;
        }

        if (TenantNewPassword != TenantConfirmPassword)
        {
            ErrorAlert = "Konfirmasi kata sandi tidak cocok.";
            return;
        }

        if (TenantNewPassword.Length < 5)
        {
            ErrorAlert = "Kata sandi minimal harus 5 karakter.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var res = await client.PostAsJsonAsync("/api/v1/auth/change-password", new
            {
                newPassword = TenantNewPassword
            });

            if (res.IsSuccessStatusCode)
            {
                SuccessAlert = "Kata sandi administrator restoran berhasil diperbarui!";
                TenantNewPassword = "";
                TenantConfirmPassword = "";
            }
            else
            {
                var body = await res.Content.ReadAsStringAsync();
                ErrorAlert = $"Gagal memperbarui kata sandi: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
