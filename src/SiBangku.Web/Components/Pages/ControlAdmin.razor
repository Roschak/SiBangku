    private async Task ChangeAdminPassword()
    {
        SuccessAlert = null;
        ErrorAlert = null;

        if (string.IsNullOrWhiteSpace(NewPassword) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            ErrorAlert = "Kata sandi baru dan konfirmasi tidak boleh kosong.";
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            ErrorAlert = "Konfirmasi kata sandi tidak cocok dengan kata sandi baru.";
            return;
        }

        if (NewPassword.Length < 5)
        {
            ErrorAlert = "Kata sandi minimal harus 5 karakter.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.PostAsJsonAsync("/api/v1/auth/change-password", new
            {
                newPassword = NewPassword
            });

            if (response.IsSuccessStatusCode)
            {
                SuccessAlert = "Kata sandi Super Admin platform berhasil diperbarui!";
                NewPassword = "";
                ConfirmPassword = "";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                ErrorAlert = $"Gagal mengubah kata sandi: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

