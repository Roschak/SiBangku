    private string GeneratePreviewSlug(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "";
        var clean = System.Text.RegularExpressions.Regex.Replace(name.ToLowerInvariant(), @"[^a-z0-9]", "");
        return clean.Length > 20 ? clean[..20] : clean;
    }

    private string GeneratePreviewCode(string name)
    {
        return GeneratePreviewSlug(name).ToUpperInvariant();
    }

    private HttpClient GetClient()
    {
        var client = ClientFactory.CreateClient("ControlApi");
        if (!string.IsNullOrEmpty(Token))
        {
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token);
        }
        return client;
    }

