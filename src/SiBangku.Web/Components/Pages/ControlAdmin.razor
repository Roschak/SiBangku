    <!-- MODAL 7: Billing & Tenggat Waktu Pembayaran (Lock / Unlock / Subs) -->
    @if (BillingTargetTenant != null)
    {
        <div class="ms-modal-backdrop" @onclick="() => BillingTargetTenant = null">
            <div class="ms-modal-card" style="max-width: 600px;" @onclick:stopPropagation="true">
                <div class="ms-modal-header" style="background: var(--ms-surface-elevated); border-bottom: 1px solid var(--ms-border);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-credit-card-2-front text-primary fs-5"></i>
                        <h6 class="ms-modal-title mb-0 fw-bold" style="color: var(--ms-text-main);">Billing & Langganan: @BillingTargetTenant.RestaurantName</h6>
                    </div>
                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="() => BillingTargetTenant = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="ms-modal-body p-4">
                    @if (!string.IsNullOrEmpty(BillingModalError))
                    {
                        <div class="ms-alert ms-alert-danger mb-3">
                            <i class="bi bi-exclamation-triangle ms-alert-icon"></i>
                            <div class="ms-alert-content small">@BillingModalError</div>
                        </div>
                    }

                    <!-- Subscription Status Overview -->
                    <div class="p-3 mb-4 rounded" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border);">
                        <div class="row g-2 font-mono small">
                            <div class="col-sm-5 text-muted">Status Layanan:</div>
                            <div class="col-sm-7">
                                @if (BillingTargetTenant.Status == "ACTIVE")
                                {
                                    <span class="ms-badge ms-badge-success">AKTIF / TERBAYAR</span>
                                }
                                else if (BillingTargetTenant.Status == "TRIAL")
                                {
                                    <span class="ms-badge ms-badge-warning">TRIAL (Uji Coba)</span>
                                }
                                else
                                {
                                    <span class="ms-badge ms-badge-danger">TERKUNCI / EXPIRED</span>
                                }
                            </div>
                            <div class="col-sm-5 text-muted">Batas Waktu Tenggat:</div>
                            <div class="col-sm-7 fw-bold" style="color: var(--ms-text-main);">
                                @(BillingTargetTenant.TrialEnd?.ToString("dd MMMM yyyy") ?? "Unlimited")
                            </div>
                        </div>
                    </div>

                    <h6 class="fw-bold mb-2 ms-serif" style="color: var(--ms-text-main);">Pilih Paket Pembayaran / Perpanjangan:</h6>
                    <div class="row g-2 mb-4">
                        <div class="col-6">
                            <button type="button" class="ms-card p-3 w-100 text-start border @(BillingPackageDays == 30 ? "border-primary bg-primary-subtle" : "")" @onclick="() => BillingPackageDays = 30">
                                <div class="fw-bold" style="color: var(--ms-text-main);">Paket Bulanan</div>
                                <div class="text-primary font-mono fw-semibold small">+30 Hari</div>
                                <small class="text-muted" style="font-size: 0.7rem;">Fleksibel per bulan</small>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="ms-card p-3 w-100 text-start border @(BillingPackageDays == 90 ? "border-primary bg-primary-subtle" : "")" @onclick="() => BillingPackageDays = 90">
                                <div class="fw-bold" style="color: var(--ms-text-main);">Paket Triwulan</div>
                                <div class="text-primary font-mono fw-semibold small">+90 Hari (3 Bulan)</div>
                                <small class="text-muted" style="font-size: 0.7rem;">Operasional menengah</small>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="ms-card p-3 w-100 text-start border @(BillingPackageDays == 180 ? "border-primary bg-primary-subtle" : "")" @onclick="() => BillingPackageDays = 180">
                                <div class="fw-bold" style="color: var(--ms-text-main);">Paket Semester</div>
                                <div class="text-primary font-mono fw-semibold small">+180 Hari (6 Bulan)</div>
                                <small class="text-muted" style="font-size: 0.7rem;">Hemat operasional</small>
                            </button>
                        </div>
                        <div class="col-6">
                            <button type="button" class="ms-card p-3 w-100 text-start border @(BillingPackageDays == 365 ? "border-primary bg-primary-subtle" : "")" @onclick="() => BillingPackageDays = 365">
                                <div class="fw-bold text-success">🌟 Paket Tahunan</div>
                                <div class="text-success font-mono fw-bold small">+365 Hari (1 Tahun)</div>
                                <small class="text-muted" style="font-size: 0.7rem;">Pilihan terbaik mitra</small>
                            </button>
                        </div>
                    </div>

                    <!-- Lock Action -->
                    <div class="p-3 rounded d-flex align-items-center justify-content-between" style="background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25);">
                        <div>
                            <div class="fw-bold text-danger small"><i class="bi bi-lock-fill me-1"></i> Kunci Layanan Tenant</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Hentikan sementara akses jika ada tunggakan pembayaran.</small>
                        </div>
                        <button type="button" class="ms-btn ms-btn-danger ms-btn-sm" @onclick='() => HandleSubmitSubscription("lock", 0)' disabled="@IsSubmitting">
                            Kunci Sekarang
                        </button>
                    </div>
                </div>
                <div class="ms-modal-footer">
                    <button type="button" class="ms-btn ms-btn-secondary" @onclick="() => BillingTargetTenant = null">Tutup</button>
                    <button type="button" class="ms-btn ms-btn-primary" @onclick='() => HandleSubmitSubscription("extend", BillingPackageDays)' disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Memproses...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>Konfirmasi Pembayaran (+@BillingPackageDays Hari)</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- MODAL 8: Modifikasi per Tenant & VS Code Studio -->
    @if (ModifyTargetTenant != null)
    {
        <div class="ms-modal-backdrop" @onclick="() => ModifyTargetTenant = null">
            <div class="ms-modal-card" style="max-width: 720px;" @onclick:stopPropagation="true">
                <div class="ms-modal-header" style="background: var(--ms-surface-elevated); border-bottom: 1px solid var(--ms-border);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-terminal-split text-info fs-5"></i>
                        <div>
                            <h6 class="ms-modal-title mb-0 fw-bold" style="color: var(--ms-text-main);">Tenant Studio & Modifikasi: @ModifyTargetTenant.RestaurantName</h6>
                            <span class="small font-mono text-muted" style="font-size: 0.72rem;">Kustomisasi Tanpa Bloat • Database-Driven • Zero Server Lag</span>
                        </div>
                    </div>
                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="() => ModifyTargetTenant = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="ms-modal-body p-4">
                    <!-- Quick VS Code Desktop Launcher -->
                    <div class="p-3 mb-3 rounded d-flex align-items-center justify-content-between" style="background: var(--ms-surface-elevated); border: 1px solid var(--ms-border);">
                        <div>
                            <div class="fw-bold" style="color: var(--ms-text-main);">
                                <i class="bi bi-code-square text-primary me-1"></i> Buka Langsung di VS Code Lokal
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">Membuka folder proyek ini langsung di aplikasi Visual Studio Code di komputer Anda.</small>
                        </div>
                        <a href="@GetVsCodeUri(ModifyTargetTenant)" class="ms-btn ms-btn-primary ms-btn-sm text-decoration-none">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Buka VS Code
                        </a>
                    </div>

                    <!-- Web Custom CSS & JSON Config Tab -->
                    <div class="mb-3">
                        <label class="ms-form-label"><i class="bi bi-palette me-1 text-primary"></i> Custom Styling CSS Tenant (Disimpan Ringan di DB)</label>
                        <textarea class="ms-form-control font-mono" rows="4" style="font-size: 0.8rem;" @bind="ModifyCustomCss"></textarea>
                    </div>

                    <!-- Interactive Console Log & Safe Terminal Simulator -->
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="ms-form-label mb-0 small"><i class="bi bi-terminal me-1 text-warning"></i> Console Terminal Simulator</label>
                            <span class="badge bg-success-subtle text-success font-mono" style="font-size: 0.68rem;">Live Sandbox</span>
                        </div>
                        <pre class="p-2.5 rounded font-mono text-success mb-2" style="background: #110E0C; font-size: 0.75rem; max-height: 120px; overflow-y: auto; white-space: pre-wrap;">@ModifyTerminalLogs</pre>
                        <div class="input-group input-group-sm">
                            <input type="text" class="form-control font-mono" placeholder="Ketik perintah (contoh: status, sync, build-info, clear)..." @bind="ModifyTerminalInput" @onkeydown="@(e => { if (e.Key == "Enter") ExecuteTerminalCommand(); })" />
                            <button class="btn btn-outline-secondary font-mono" type="button" @onclick="ExecuteTerminalCommand">Run</button>
                        </div>
                    </div>
                </div>
                <div class="ms-modal-footer">
                    <button type="button" class="ms-btn ms-btn-secondary" @onclick="() => ModifyTargetTenant = null">Tutup</button>
                    <button type="button" class="ms-btn ms-btn-success" @onclick="@(() => { ModifyTerminalLogs += "\n[System] Pengaturan custom CSS berhasil disimpan ke DB!"; })">
                        <i class="bi bi-check2 me-1"></i> Simpan Modifikasi ke DB
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    private bool IsLoggedIn = false;
    private string Email = "";
    private string Password = "";
    private string AdminName = "Super Admin";
    private string ProfileName = "Super Admin";
    private string ProfileEmail = "";
    private string? LoginError;
    private string? LoginSuccessMessage;
    
    // Global Alerts
    private string? SuccessAlert;
    private string? ErrorAlert;

    private string Token = "";
    private bool IsSubmitting = false;
    private bool HasAttemptedLogin = false;
    private string ActiveTab = "tenants";
    private string SearchQuery = "";

    // Provisioning Models
    private class ProvisionModel
    {
        public string TenantName { get; set; } = "";
        public string RestaurantName { get; set; } = "";
        public string AdminEmail { get; set; } = "";
        public string AdminPassword { get; set; } = "";
