    }

    private async Task HandleLogin()
    {
        HasAttemptedLogin = true;
        LoginError = null;
        LoginSuccessMessage = null;

        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Password))
        {
            LoginError = "Username/Email dan kata sandi wajib diisi.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.PostAsJsonAsync("/api/v1/auth/login", new 
            { 
                email = Email?.Trim(), 
                password = Password 
            });
            
            if (response.IsSuccessStatusCode)
            {
                var doc = await response.Content.ReadFromJsonAsync<JsonElement>();
                var data = doc.GetProperty("data");
                Token = data.GetProperty("token").GetString() ?? "";
                
                if (data.TryGetProperty("user", out var userProp))
                {
                    var rawName = userProp.TryGetProperty("name", out var np) ? np.GetString() : null;
                    var rawEmail = userProp.TryGetProperty("email", out var ep) ? ep.GetString() : null;
                    AdminName = !string.IsNullOrEmpty(rawName) ? rawName : "Super Admin";
                    Email = (!string.IsNullOrEmpty(rawEmail) ? rawEmail : Email) ?? "";
                    ProfileName = AdminName;
                    ProfileEmail = Email;
                }

                IsLoggedIn = true;
                await RefreshTenants();
                await RefreshAuditLogs();
            }
            else
            {
                try
                {
                    var errDoc = await response.Content.ReadFromJsonAsync<JsonElement>();
                    if (errDoc.TryGetProperty("error", out var ep) && ep.TryGetProperty("message", out var mp))
                    {
                        LoginError = mp.GetString() ?? "Kredensial tidak valid.";
                    }
                    else
                    {
                        LoginError = "Kredensial Super Admin tidak valid. Periksa username dan password Anda.";
                    }
                }
                catch
                {
                    LoginError = "Kredensial Super Admin tidak valid. Periksa username dan password Anda.";
                }
            }
        }
        catch (Exception ex)
        {
            if (ex is HttpRequestException || ex.Message.Contains("refused") || ex.Message.Contains("connection"))
            {
                LoginError = "Gagal terhubung ke Backend Control API (http://localhost:3001). Pastikan service SiBangku.ControlApi sudah dijalankan.";
            }
            else
            {
                LoginError = $"Terjadi kendala koneksi: {ex.Message}";
            }
        }
        finally
        {
            IsSubmitting = false;
            StateHasChanged();
        }
    }

