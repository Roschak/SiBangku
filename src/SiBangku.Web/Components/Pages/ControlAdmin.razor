    private async Task HandleCreateTenant()
    {
        SuccessAlert = null;
        ErrorAlert = null;

        if (string.IsNullOrWhiteSpace(NewTenant.TenantName) || string.IsNullOrWhiteSpace(NewTenant.RestaurantName) || string.IsNullOrWhiteSpace(NewTenant.AdminEmail))
        {
            ErrorAlert = "Harap isi Nama Perusahaan, Nama Restoran, dan Email Admin Resto.";
            return;
        }

        if (!string.IsNullOrWhiteSpace(NewTenant.AdminPassword) && NewTenant.AdminPassword.Trim().Length < 5)
        {
            ErrorAlert = "Kata sandi yang ditentukan minimal harus 5 karakter.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.PostAsJsonAsync("/api/v1/tenants", new
            {
                tenantName = NewTenant.TenantName.Trim(),
                restaurantName = NewTenant.RestaurantName.Trim(),
                adminEmail = NewTenant.AdminEmail.Trim(),
                adminPassword = NewTenant.AdminPassword?.Trim(),
                trialDays = NewTenant.TrialDays
            });

            if (response.IsSuccessStatusCode)
            {
                var doc = await response.Content.ReadFromJsonAsync<JsonElement>();
                var data = doc.GetProperty("data");
                var code = data.GetProperty("tenantCode").GetString() ?? "";
                var tempPass = data.GetProperty("temporaryPassword").GetString() ?? "";
                var dbName = data.GetProperty("databaseName").GetString() ?? "";

                ProvisionedSuccessModal = new ProvisionedDataResult
                {
                    TenantCode = code,
                    RestaurantName = NewTenant.RestaurantName,
                    AdminEmail = NewTenant.AdminEmail,
                    TemporaryPassword = tempPass,
                    DatabaseName = dbName
                };

                SuccessAlert = $"Tenant '{NewTenant.RestaurantName}' ({code}) berhasil di-provisioning!";
                NewTenant = new ProvisionModel();
                await RefreshTenants();
                ActiveTab = "tenants";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                ErrorAlert = $"Provisioning Gagal: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    // --- Reset Password Modal Handlers ---
    private void PromptResetTenantPassword(Tenant tenant)
    {
        ResetTargetTenant = tenant;
        ResetNewPassword = "";
        ResetConfirmPassword = "";
        ResetModalError = null;
    }

    private async Task HandleResetTenantPasswordSubmit()
    {
        if (ResetTargetTenant == null) return;
        ResetModalError = null;

        if (string.IsNullOrWhiteSpace(ResetNewPassword))
        {
            ResetModalError = "Kata sandi baru tidak boleh kosong.";
            return;
        }

        if (ResetNewPassword.Length < 5)
        {
            ResetModalError = "Kata sandi minimal harus 5 karakter.";
            return;
        }

        if (ResetNewPassword != ResetConfirmPassword)
        {
            ResetModalError = "Konfirmasi kata sandi tidak cocok.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.PostAsJsonAsync($"/api/v1/tenants/{ResetTargetTenant.TenantId}/reset-password", new
            {
                newPassword = ResetNewPassword
            });

            if (response.IsSuccessStatusCode)
            {
                SuccessAlert = $"Kata sandi admin resto untuk '{ResetTargetTenant.RestaurantName}' ({ResetTargetTenant.TenantCode}) berhasil diatur ulang menjadi: {ResetNewPassword}";
                ResetTargetTenant = null;
                ResetNewPassword = "";
                ResetConfirmPassword = "";
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                ResetModalError = $"Gagal mereset kata sandi: {body}";
            }
        }
        catch (Exception ex)
        {
            ResetModalError = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    // --- Delete Tenant Modal Handlers ---
    private void PromptDeleteTenant(Tenant tenant)
    {
        DeleteTargetTenant = tenant;
        DeleteConfirmationInput = "";
    }

    private async Task HandleConfirmDeleteTenant()
    {
        if (DeleteTargetTenant == null) return;
        if (!DeleteConfirmationInput.Equals(DeleteTargetTenant.TenantCode, StringComparison.OrdinalIgnoreCase))
        {
            ErrorAlert = "Konfirmasi kode tenant tidak cocok.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.DeleteAsync($"/api/v1/tenants/{DeleteTargetTenant.TenantId}");
            if (response.IsSuccessStatusCode)
            {
                SuccessAlert = $"Tenant '{DeleteTargetTenant.RestaurantName}' dan database fisiknya berhasil dihapus secara permanen.";
                DeleteTargetTenant = null;
                await RefreshTenants();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                ErrorAlert = $"Gagal menghapus tenant: {body}";
            }
        }
        catch (Exception ex)
        {
            ErrorAlert = $"Gagal: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

    // --- Extend Trial Modal Handlers ---
    private void PromptExtendTrial(Tenant tenant)
    {
        ExtendTargetTenant = tenant;
        ExtendDaysCount = 30;
    }

    private async Task HandleConfirmExtendTrial()
    {
        if (ExtendTargetTenant == null) return;
        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var response = await client.PatchAsJsonAsync($"/api/v1/tenants/{ExtendTargetTenant.TenantId}/extend-trial", new { days = ExtendDaysCount });
