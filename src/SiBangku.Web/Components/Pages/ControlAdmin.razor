    private async Task HandleSubmitEditTenant()
    {
        if (EditTargetTenant == null) return;
        EditModalError = null;
        if (string.IsNullOrWhiteSpace(EditRestaurantName) || string.IsNullOrWhiteSpace(EditTenantName))
        {
            EditModalError = "Nama restoran dan nama perusahaan tidak boleh kosong.";
            return;
        }

        IsSubmitting = true;
        try
        {
            var client = GetClient();
            var res = await client.PutAsJsonAsync($"/api/v1/tenants/{EditTargetTenant.TenantId}", new
            {
                restaurantName = EditRestaurantName.Trim(),
                tenantName = EditTenantName.Trim(),
                adminEmail = EditAdminEmail.Trim()
            });

            if (!res.IsSuccessStatusCode)
            {
                var err = await res.Content.ReadAsStringAsync();
                EditModalError = $"Gagal menyimpan perubahan: {err}";
                return;
            }

            if (!string.IsNullOrWhiteSpace(EditNewPassword))
            {
                if (EditNewPassword.Trim().Length < 5)
                {
                    EditModalError = "Kata sandi baru minimal harus 5 karakter.";
                    return;
                }
                var pwRes = await client.PostAsJsonAsync($"/api/v1/tenants/{EditTargetTenant.TenantId}/reset-password", new
                {
                    newPassword = EditNewPassword.Trim()
                });
                if (!pwRes.IsSuccessStatusCode)
                {
                    var err = await pwRes.Content.ReadAsStringAsync();
                    EditModalError = $"Perubahan nama berhasil, namun gagal memperbarui kata sandi: {err}";
                    return;
                }
            }

            SuccessAlert = $"Profil mitra '{EditRestaurantName}' berhasil diperbarui!";
            EditTargetTenant = null;
            await RefreshTenants();
        }
        catch (Exception ex)
        {
            EditModalError = $"Error: {ex.Message}";
        }
        finally
        {
            IsSubmitting = false;
        }
    }

