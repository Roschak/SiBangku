                    <div class="d-grid gap-2 mb-3">
                        <a href="/downloads/SiBangku-Universal-App.apk" download="SiBangku-@(SelectedPackageTenant.TenantCode.ToLowerInvariant()).apk" class="ms-btn ms-btn-outline d-flex align-items-center justify-content-between p-3 text-decoration-none">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-android2 fs-3 text-success"></i>
                                <div class="text-start">
                                    <div class="fw-bold" style="color: var(--ms-text-main);">Paket APK Android (.apk)</div>
                                    <small class="text-muted font-mono" style="font-size: 0.72rem;">Ringan & hemat baterai, cocok untuk HP spesifikasi standar</small>
                                </div>
                            </div>
                            <span class="ms-badge ms-badge-primary"><i class="bi bi-download me-1"></i> Unduh APK</span>
                        </a>

                        <a href="/downloads/SiBangku-Desktop-App.exe" download="SiBangku-Desktop-@(SelectedPackageTenant.TenantCode.ToLowerInvariant()).exe" class="ms-btn ms-btn-outline d-flex align-items-center justify-content-between p-3 text-decoration-none">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-windows fs-3 text-primary"></i>
                                <div class="text-start">
                                    <div class="fw-bold" style="color: var(--ms-text-main);">Paket Desktop Windows (.exe)</div>
                                    <small class="text-muted font-mono" style="font-size: 0.72rem;">Native Windows launcher instan (~4 KB, RAM &lt; 30MB)</small>
                                </div>
                            </div>
                            <span class="ms-badge ms-badge-primary"><i class="bi bi-download me-1"></i> Unduh EXE</span>
                        </a>

                        <a href="/downloads/SiBangku-Desktop-Launcher.bat" download="SiBangku-Launcher-@(SelectedPackageTenant.TenantCode.ToLowerInvariant()).bat" class="ms-btn ms-btn-outline d-flex align-items-center justify-content-between p-2.5 text-decoration-none">
                            <div class="d-flex align-items-center gap-3">
                                <i class="bi bi-terminal fs-4 text-warning"></i>
                                <div class="text-start">
                                    <div class="fw-semibold small" style="color: var(--ms-text-main);">Desktop Script Launcher (.bat)</div>
                                    <small class="text-muted font-mono" style="font-size: 0.7rem;">Skrip batch untuk POS kasir Windows</small>
                                </div>
                            </div>
                            <span class="ms-badge ms-badge-secondary"><i class="bi bi-download me-1"></i> Unduh BAT</span>
                        </a>
                    </div>
                </div>
                <div class="ms-modal-footer">
                    <button type="button" class="ms-btn ms-btn-secondary" @onclick="() => SelectedPackageTenant = null">Tutup</button>
                    <a href="/tenant-admin" target="_blank" class="ms-btn ms-btn-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Buka Portal Outlet
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- MODAL 6: Edit Tenant Profile & Credentials Modal -->
    @if (EditTargetTenant != null)
    {
        <div class="ms-modal-backdrop" @onclick="() => EditTargetTenant = null">
            <div class="ms-modal-card" style="max-width: 580px;" @onclick:stopPropagation="true">
                <div class="ms-modal-header" style="background: var(--ms-surface-elevated); border-bottom: 1px solid var(--ms-border);">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-pencil-square text-primary fs-5"></i>
                        <h6 class="ms-modal-title mb-0 fw-bold" style="color: var(--ms-text-main);">Edit Profil Mitra: @EditTargetTenant.TenantCode</h6>
                    </div>
                    <button type="button" class="ms-btn ms-btn-secondary ms-btn-sm" @onclick="() => EditTargetTenant = null">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="ms-modal-body p-4">
                    @if (!string.IsNullOrEmpty(EditModalError))
                    {
                        <div class="ms-alert ms-alert-danger mb-3">
                            <i class="bi bi-exclamation-triangle ms-alert-icon"></i>
                            <div class="ms-alert-content small">@EditModalError</div>
                        </div>
                    }

                    <div class="ms-form-group mb-3">
                        <label class="ms-form-label"><i class="bi bi-shop me-1 text-primary"></i> Nama Restoran (Brand Tamu)</label>
                        <input type="text" class="ms-form-control" @bind="EditRestaurantName" required />
                    </div>

                    <div class="ms-form-group mb-3">
                        <label class="ms-form-label"><i class="bi bi-building me-1 text-primary"></i> Nama Perusahaan / Legal Tenant</label>
                        <input type="text" class="ms-form-control" @bind="EditTenantName" required />
                    </div>

                    <div class="ms-form-group mb-3">
                        <label class="ms-form-label"><i class="bi bi-envelope me-1 text-primary"></i> Email Admin Resto (Username)</label>
                        <input type="email" class="ms-form-control font-mono" @bind="EditAdminEmail" required />
                    </div>

                    <div class="ms-form-group mb-0">
                        <label class="ms-form-label"><i class="bi bi-key me-1 text-warning"></i> Ganti Kata Sandi Baru (Opsional)</label>
                        <input type="password" class="ms-form-control font-mono" @bind="EditNewPassword" placeholder="Biarkan kosong jika tidak diubah" />
                        <small class="text-muted font-mono" style="font-size: 0.7rem;">Minimal 5 karakter. Di-hash dengan enkripsi BCrypt aman.</small>
                    </div>
                </div>
                <div class="ms-modal-footer">
                    <button type="button" class="ms-btn ms-btn-secondary" @onclick="() => EditTargetTenant = null">Batal</button>
                    <button type="button" class="ms-btn ms-btn-primary" @onclick="HandleSubmitEditTenant" disabled="@IsSubmitting">
                        @if (IsSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Menyimpan...</span>
                        }
                        else
                        {
                            <i class="bi bi-check2 me-1"></i>
                            <span>Simpan Perubahan</span>
