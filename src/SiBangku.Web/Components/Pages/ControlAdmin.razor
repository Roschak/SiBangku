    private void ExecuteTerminalCommand()
    {
        if (string.IsNullOrWhiteSpace(ModifyTerminalInput)) return;
        var cmd = ModifyTerminalInput.Trim().ToLowerInvariant();
        var now = DateTime.Now.ToString("HH:mm:ss");
        ModifyTerminalLogs += $"\n[{now}] $ {ModifyTerminalInput}\n";

        if (cmd == "help")
        {
            ModifyTerminalLogs += "Daftar perintah:\n  status      - Cek status tenant dan koneksi DB\n  sync        - Simulasi sinkronisasi APK/PWA\n  build-info  - Info build binary\n  clear       - Bersihkan layar terminal";
        }
        else if (cmd == "status")
        {
            ModifyTerminalLogs += $"Tenant: {ModifyTargetTenant?.RestaurantName} ({ModifyTargetTenant?.TenantCode})\nStatus: {ModifyTargetTenant?.Status}\nDatabase: {ModifyTargetTenant?.DatabaseIdentifier} [Connected]";
        }
        else if (cmd == "sync")
        {
            ModifyTerminalLogs += "Menyinkronkan data CSS & menu ke endpoint PWA/APK... Selesai 100%.";
        }
        else if (cmd == "build-info")
        {
            ModifyTerminalLogs += "APK: SiBangku-Universal-App.apk (~2 KB)\nEXE: SiBangku-Desktop-App.exe (4.6 KB, RAM < 30MB)";
        }
        else if (cmd == "clear")
        {
            ModifyTerminalLogs = "[Terminal dibersihkan]";
        }
        else
        {
            ModifyTerminalLogs += $"Perintah '{cmd}' tidak dikenali. Ketik 'help' untuk panduan.";
        }
        ModifyTerminalInput = "";
    }
